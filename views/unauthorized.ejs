<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Access Restricted | FLOURish</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>


<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen flex flex-col">


    <!-- NAVBAR -->

    <nav class="sticky top-0 z-40 bg-[#F8F4EE]/80 backdrop-blur-md border-b border-[#E8DCCB]">

        <div class="max-w-7xl mx-auto px-6">

            <div class="h-20 flex items-center justify-between">

                <!-- LOGO -->

                <a href="/" class="flex items-center gap-3">

                    <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                    <h1 class="font-serif text-4xl">

                        FLOUR<span class="italic text-[#C9A36B]">ish</span>

                    </h1>

                </a>


                <!-- NAVIGATION -->

                <div class="flex items-center gap-8">

                    <a
                        href="/menu"
                        class="hover:text-[#C9A36B] transition"
                    >
                        Menu
                    </a>

                    <a
                        href="/cart"
                        class="hover:text-[#C9A36B] transition"
                        title="Cart"
                    >
                        <i class="fa-solid fa-cart-shopping text-xl"></i>
                    </a>

                    <a
                        href="/orders"
                        class="hover:text-[#C9A36B] transition"
                        title="Orders"
                    >
                        <i class="fa-solid fa-box text-xl"></i>
                    </a>

                </div>

            </div>

        </div>

    </nav>


    <!-- MAIN -->

    <main class="flex-1 flex items-center justify-center px-6 py-20">

        <div class="w-full max-w-xl">


            <!-- CARD -->

            <div class="bg-white border border-[#E8DCCB] rounded-3xl shadow-sm overflow-hidden">


                <!-- CONTENT -->

                <div class="px-8 sm:px-12 pt-12 pb-10 text-center">


                    <!-- ICON -->

                    <div
                        class="w-24 h-24 mx-auto rounded-full bg-[#F8F4EE] flex items-center justify-center"
                    >

                        <i
                            class="fa-solid fa-shield-halved text-4xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <!-- LABEL -->

                    <p
                        class="mt-8 uppercase tracking-[0.2em] text-xs font-semibold text-[#8B7765]"
                    >
                        Access Restricted
                    </p>


                    <!-- TITLE -->

                    <h1 class="font-serif text-4xl sm:text-5xl mt-3">
                        You can't access this
                    </h1>


                    <!-- MESSAGE -->

                    <p class="mt-5 text-[#6B5B50] leading-relaxed">

                        You don't have permission to perform this action
                        or access the requested resource.

                    </p>


                    <!-- SECURITY MESSAGE -->

                    <div
                        class="mt-8 text-left bg-[#FAF7F2] border border-[#E8DCCB] rounded-2xl p-5"
                    >

                        <div class="flex items-start gap-4">

                            <div
                                class="w-10 h-10 shrink-0 rounded-xl bg-white border border-[#E8DCCB] flex items-center justify-center"
                            >

                                <i class="fa-solid fa-lock text-[#C9A36B]"></i>

                            </div>


                            <div>

                                <p class="font-semibold">
                                    Your account is protected
                                </p>

                                <p class="text-sm text-[#6B5B50] mt-1 leading-relaxed">

                                    Some information and actions are restricted
                                    to authorized users to protect account and
                                    order information.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div
                    class="border-t border-[#E8DCCB] bg-[#FAF7F2] p-8"
                >

                    <div class="flex flex-col sm:flex-row gap-4 justify-center">

                        <a
                            href="/"
                            class="inline-flex items-center justify-center px-7 py-4 rounded-xl bg-[#C9A36B] hover:bg-[#B89056] text-[#2F241D] font-semibold transition"
                        >

                            <i class="fa-solid fa-house mr-2"></i>

                            Back to Home

                        </a>


                        <a
                            href="/orders"
                            class="inline-flex items-center justify-center px-7 py-4 rounded-xl border border-[#E8DCCB] hover:bg-white font-semibold transition"
                        >

                            <i class="fa-solid fa-box mr-2"></i>

                            My Orders

                        </a>

                    </div>

                </div>

            </div>


            <!-- SUPPORT -->

            <p class="text-center text-sm text-[#8B7765] mt-6">

                Think this is a mistake?

                <a
                    href="/support"
                    class="text-[#C9A36B] hover:text-[#B89056] font-medium"
                >
                    Contact Support
                </a>

            </p>

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="border-t border-[#E8DCCB] py-6">

        <p class="text-center text-sm text-[#8B7765]">

            &copy; <%= new Date().getFullYear() %> FLOURish Bakery.
            All rights reserved.

        </p>

    </footer>


</body>

</html>