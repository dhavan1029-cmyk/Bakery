<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders | FLOURish</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>

<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen flex flex-col">
<!-- NAVBAR -->

    <nav class="bg-[#F8F4EE]/80 backdrop-blur-md border-b border-[#E8DCCB] sticky top-0 z-50">

        <div class="max-w-7xl mx-auto px-6">

            <div class="h-20 flex items-center justify-between">

                <a href="/" class="flex items-center gap-3">

                    <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                    <h1 class="font-serif text-4xl">

                        FLOUR<span class="italic text-[#C9A36B]">ish</span>

                    </h1>

                </a>

                <div class="flex items-center gap-8">

                    <a
                        href="/menu"
                        class="hover:text-[#C9A36B] transition"
                    >

                        Menu

                    </a>

                    <a
                        href="/cart"
                        class="hover:text-[#C9A36B] transition"
                    >

                        <i class="fa-solid fa-cart-shopping text-xl"></i>

                    </a>

                    <a
                        href="account"
                        class="hover:text-[#C9A36B] transition"
                    >

                        <i class="fa-solid fa-user text-xl"></i>

                    </a>

                </div>

            </div>

        </div>

    </nav>

    <!-- PAGE HEADER -->

    <section class="py-14">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">

                <div>

                    <h1 class="font-serif text-6xl">

                        My Orders

                    </h1>

                    <p class="mt-3 text-[#6B5B50]">

                        Track your active orders and browse your complete order history.

                    </p>

                </div>

                <a
                    href="/menu"
                    class="inline-flex items-center gap-3 bg-[#C9A36B] hover:bg-[#B89056] text-[#2F241D] font-semibold px-6 py-3 rounded-xl transition"
                >

                    <i class="fa-solid fa-basket-shopping"></i>

                    Order More

                </a>

            </div>





            <!-- ORDER FILTERS -->

            <div class="mt-12 flex flex-wrap gap-3">

                <button
                    class="px-6 py-3 rounded-full bg-[#C9A36B] text-[#2F241D] font-semibold"
                >

                    All Orders

                </button>

                <button
                    class="px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                >

                    Active

                </button>

                <button
                    class="px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                >

                    Delivered

                </button>

                <button
                    class="px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                >

                    Cancelled

                </button>

            </div>

        </div>

    </section>
    
    <!-- ORDER CARD -->

    <% if (!orders.length) { %>

        <!-- EMPTY STATE -->

        <section class="flex-1">

            <div class="max-w-3xl mx-auto px-6 py-20">

                <div class="rounded-3xl shadow-sm p-12 text-center">

                    <div class="w-28 h-28 mx-auto rounded-full bg-[#F8F4EE] flex items-center justify-center">

                        <i class="fa-solid fa-box-open text-5xl text-[#C9A36B]"></i>

                    </div>

                    <h2 class="font-serif text-5xl mt-8">

                        No Orders Yet

                    </h2>

                    <p class="mt-5 text-[#6B5B50] leading-relaxed max-w-xl mx-auto">

                        Looks like you haven't placed your first order yet.
                        Fresh breads, cakes and pastries are waiting for you.

                    </p>

                    <a
                        href="/menu"
                        class="inline-flex items-center gap-3 mt-10 bg-[#C9A36B] hover:bg-[#B89056] text-[#2F241D] font-semibold px-8 py-4 rounded-xl transition"
                    >

                        <i class="fa-solid fa-basket-shopping"></i>

                        Browse Menu

                    </a>

                </div>

            </div>

        </section>

    <% } else { %>

        <section class="pb-24 flex-1">

            <div class="max-w-7xl mx-auto px-6 lg:px-10 space-y-8">

                <% orders.forEach(order => { %>

                    <!-- ORDER CARD -->

                    <div class="bg-white rounded-3xl border border-[#E8DCCB] overflow-hidden">

                        <!-- HEADER -->

                        <div class="px-8 py-6 border-b border-[#E8DCCB]">

                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

                                <div>

                                    <p class="uppercase tracking-widest text-xs text-[#8B7765]">

                                        Order ID

                                    </p>

                                    <h2 class="font-serif text-3xl mt-2">

                                        #<%= order._id %>

                                    </h2>

                                </div>

                                <div class="text-left lg:text-right">

                                    <p class="text-[#6B5B50]">

                                        <%= new Date(order.createdAt).toLocaleDateString() %>

                                    </p>

                                    <span
                                        class="
                                            inline-flex items-center mt-3 px-4 py-2 rounded-full text-sm font-semibold

                                            <%= order.status === 'Delivered'
                                                ? 'bg-green-100 text-green-700'
                                                : order.status === 'Cancelled'
                                                ? 'bg-red-100 text-red-700'
                                                : order.status === 'Preparing'
                                                ? 'bg-yellow-100 text-yellow-700'
                                                : order.status === 'Out for Delivery'
                                                ? 'bg-blue-100 text-blue-700'
                                                : 'bg-gray-100 text-gray-700'
                                            %>
                                        "
                                    >

                                        <%= order.status %>

                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- PRODUCT PREVIEW -->

                        <div class="px-8 py-6">

                            <div class="space-y-5">

                                <% order.products.slice(0, 3).forEach(item => { %>

                                    <div class="flex items-center justify-between">

                                        <div class="flex items-center gap-4">

                                            <div
                                                class="w-16 h-16 rounded-xl bg-[#E8DCCB]"
                                                style="<%= item.product.image ? `background-image:url('${item.product.image}');background-size:cover;background-position:center;` : '' %>"
                                            ></div>

                                            <div>

                                                <p class="font-medium">

                                                    <%= item.product.name %>

                                                </p>

                                                <p class="text-sm text-[#6B5B50]">

                                                    Qty: <%= item.quantity %>

                                                </p>

                                            </div>

                                        </div>

                                        <p class="font-semibold">

                                            ₹<%= item.product.price * item.quantity %>

                                        </p>

                                    </div>

                                <% }) %>

                                <% if (order.products.length > 3) { %>

                                    <p class="text-sm text-[#6B5B50]">

                                        + <%= order.products.length - 3 %> more item(s)

                                    </p>

                                <% } %>

                            </div>

                        </div>

                        <!-- FOOTER -->

                        <div class="bg-[#FAF7F2] border-t border-[#E8DCCB] px-8 py-6">

                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

                                <div>

                                    <p class="text-sm text-[#8B7765]">

                                        Total Amount

                                    </p>

                                    <p class="font-bold text-3xl mt-1">

                                        ₹<%= order.totalPrice %>

                                    </p>

                                </div>

                                <div class="flex flex-wrap gap-3">

                                    <a
                                        href="/orders/<%= order._id %>"
                                        class="px-6 py-3 rounded-xl bg-[#C9A36B] hover:bg-[#B89056] font-semibold transition"
                                    >

                                        View Details

                                    </a>

                                    <% if (['Placed', 'Confirmed', 'Preparing'].includes(order.status)) { %>

                                        <button
                                            class="cancel-order px-6 py-3 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 transition"
                                            data-id="<%= order._id %>"
                                        >

                                            Cancel Order

                                        </button>

                                    <% } %>

                                    <% if (['Delivered', 'Cancelled'].includes(order.status)) { %>

                                        <button
                                            class="reorder px-6 py-3 rounded-xl border border-[#E8DCCB] hover:bg-white transition"
                                            data-id="<%= order._id %>"
                                        >

                                            Reorder

                                        </button>

                                    <% } %>

                                    <% if (order.status === 'Out for Delivery') { %>

                                        <a
                                            href="/orders/<%= order._id %>"
                                            class="px-6 py-3 rounded-xl border border-[#E8DCCB] hover:bg-white transition"
                                        >

                                            Track Order

                                        </a>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        </section>

    <% } %>

</body>

</html>