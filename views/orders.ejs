<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders | FLOURish</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>

<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen flex flex-col">
<!-- NAVBAR -->

    <nav class="bg-[#F8F4EE]/80 backdrop-blur-md border-b border-[#E8DCCB] sticky top-0 z-50">

        <div class="max-w-7xl mx-auto px-6">

            <div class="h-20 flex items-center justify-between">

                <a href="/" class="flex items-center gap-3">

                    <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                    <h1 class="font-serif text-4xl">

                        FLOUR<span class="italic text-[#C9A36B]">ish</span>

                    </h1>

                </a>

                <div class="flex items-center gap-8">

                    <a
                        href="/menu"
                        class="hover:text-[#C9A36B] transition"
                    >

                        Menu

                    </a>

                    <a
                        href="/cart"
                        class="hover:text-[#C9A36B] transition"
                    >

                        <i class="fa-solid fa-cart-shopping text-xl"></i>

                    </a>

                    <a
                        href="account"
                        class="hover:text-[#C9A36B] transition"
                    >

                        <i class="fa-solid fa-user text-xl"></i>

                    </a>

                </div>

            </div>

        </div>

    </nav>

    <!-- PAGE HEADER -->

    <section class="py-14">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">

                <div>

                    <h1 class="font-serif text-6xl">

                        My Orders

                    </h1>

                    <p class="mt-3 text-[#6B5B50]">

                        Track your active orders and browse your complete order history.

                    </p>

                </div>

                <a
                    href="/menu"
                    class="inline-flex items-center gap-3 bg-[#C9A36B] hover:bg-[#B89056] text-[#2F241D] font-semibold px-6 py-3 rounded-xl transition"
                >

                    <i class="fa-solid fa-basket-shopping"></i>

                    Order More

                </a>

            </div>



            <% if(orders.length){ %>

                <!-- ORDER FILTERS -->

                <div class="mt-12 flex flex-wrap gap-3">

                    <button
                        class="filters px-6 py-3 rounded-full bg-[#C9A36B] text-[#2F241D] font-semibold"
                        id="all"
                    >

                        All Orders

                    </button>

                    <button
                        class="filters px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                        id="active"
                    >

                        Active

                    </button>

                    <button
                        class="filters px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                        id="delivered"
                    >

                        Delivered

                    </button>

                    <button
                        class="filters px-6 py-3 rounded-full border border-[#E8DCCB] hover:border-[#C9A36B] hover:bg-white transition"
                        id="cancelled"
                    >

                        Cancelled

                    </button>

                </div>

            <% } %>

        </div>

    </section>
    
    <!-- CANCEL ORDER MODAL -->

    <div
        id="cancel-order-modal"
        class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden items-center justify-center px-6"
    >
    
        <div class="m-auto my-[20vh] w-full max-w-lg bg-white rounded-3xl shadow-2xl overflow-hidden">
        
            <!-- HEADER -->
        
            <div class="px-8 pt-8">
            
                <div class="w-16 h-16 rounded-2xl bg-red-100 flex items-center justify-center">
                
                    <i class="fa-solid fa-triangle-exclamation text-3xl text-red-500"></i>
                
                </div>
            
                <h2 class="font-serif text-4xl mt-6">
                
                    Cancel Order?
                
                </h2>
            
                <p class="mt-4 text-[#6B5B50] leading-relaxed">
                
                    Are you sure you want to cancel this order?
                    Once cancelled, the bakery will stop processing it and
                    this action cannot be undone.
                
                </p>
            
            </div>
        
        
        
        
        
            <!-- BUTTONS -->
        
            <div class="px-8 py-8 mt-8 border-t border-[#E8DCCB] bg-[#FAF7F2]">
            
                <div class="flex flex-col sm:flex-row gap-4 justify-end">
                
                    <button
                        id="keep-order-btn"
                        type="button"
                        class="px-8 py-4 rounded-xl border border-[#E8DCCB] font-semibold hover:bg-white transition"
                    >
                
                        Keep Order
                
                    </button>
                
                    <button
                        id="confirm-cancel-order-btn"
                        type="button"
                        class="px-8 py-4 rounded-xl bg-red-500 hover:bg-red-600 text-white font-semibold transition"
                    >
                
                        <i class="fa-solid fa-ban mr-2"></i>
                
                        Cancel Order
                
                    </button>
                
                </div>
            
            </div>
        
        </div>
    
    </div>
    
        <!-- ORDER CARD -->
    
    <% if (!orders.length) { %>
        
        <!-- EMPTY STATE -->

        <section class="flex-1">

            <div class="max-w-3xl mx-auto px-6 py-20">

                <div class="rounded-3xl shadow-sm p-12 text-center">

                    <div class="w-28 h-28 mx-auto rounded-full bg-[#F8F4EE] flex items-center justify-center">

                        <i class="fa-solid fa-box-open text-5xl text-[#C9A36B]"></i>

                    </div>

                    <h2 class="font-serif text-5xl mt-8">

                        No Orders Yet

                    </h2>

                    <p class="mt-5 text-[#6B5B50] leading-relaxed max-w-xl mx-auto">

                        Looks like you haven't placed your first order yet.
                        Fresh breads, cakes and pastries are waiting for you.

                    </p>

                    <a
                        href="/menu"
                        class="inline-flex items-center gap-3 mt-10 bg-[#C9A36B] hover:bg-[#B89056] text-[#2F241D] font-semibold px-8 py-4 rounded-xl transition"
                    >

                        <i class="fa-solid fa-basket-shopping"></i>

                        Browse Menu

                    </a>

                </div>

            </div>

        </section>

    <% } else { %>

        <section class="pb-24 flex-1">

            <!-- NO FILTER RESULTS -->
                
            <div id="no-filter-results" class="hidden rounded-3xl p-16 text-center">
            
                <div class="w-24 h-24 mx-auto rounded-full bg-[#FAF7F2] flex items-center justify-center">
                
                    <i class="fa-solid fa-filter-circle-xmark text-5xl text-[#C9A36B]"></i>
                
                </div>
            
                <h2 class="mt-8 font-serif text-4xl text-[#2F241D]">
                    No Matching Orders
                </h2>
            
                <p class="mt-4 max-w-xl mx-auto text-[#6B5B50] leading-relaxed">
                    We couldn't find any orders matching your current filters.
                    Try changing your filters or clear them to view all of your orders.
                </p>
            
            </div>
        
        
            <!-- ORDERS -->
        
            <div class="max-w-7xl mx-auto px-6 space-y-8">
            
                <% if (orders?.length) { %>
                
                    <% orders.forEach(order => { %>
                    
                        <!-- ORDER CARD -->
                    
                        <article
                            class="order-card bg-white rounded-3xl overflow-hidden border transition-all"
                            data-status="<%= order.status %>"
                        >
                    
                            <!-- HEADER -->
                    
                            <div class="px-8 py-6 border-b border-[#E8DCCB]">
                            
                                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                                
                                    <!-- ORDER INFORMATION -->
                                
                                    <div>
                                    
                                        <p class="uppercase tracking-widest text-xs text-[#8B7765]">
                                            Order ID
                                        </p>
                                    
                                        <h2 class="font-serif text-3xl mt-2 break-all">
                                            #<%= order._id %>
                                        </h2>
                                    
                                        <p class="text-sm text-[#6B5B50] mt-2">
                                            <%= new Date(order.createdAt).toLocaleDateString('en-IN', {
                                                day: 'numeric',
                                                month: 'long',
                                                year: 'numeric'
                                            }) %>
                                        </p>
                                    
                                    </div>
                                
                                
                                    <!-- STATUS -->
                                
                                    <div class="text-left lg:text-right">
                                    
                                        <span
                                            class="
                                                inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold
                                    
                                                <%= order.status === 'Delivered'
                                                    ? 'bg-green-100 text-green-700'
                                                    : order.status === 'Cancelled'
                                                    ? 'bg-red-100 text-red-700'
                                                    : order.status === 'Baking'
                                                    ? 'bg-orange-100 text-orange-700'
                                                    : order.status === 'Out for Delivery'
                                                    ? 'bg-blue-100 text-blue-700'
                                                    : 'bg-yellow-100 text-yellow-700'
                                                %>
                                            "
                                        >
                                    
                                            <% if (order.status === 'Delivered') { %>
                                            
                                                <i class="fa-solid fa-circle-check mr-2"></i>
                                            
                                            <% } else if (order.status === 'Cancelled') { %>
                                            
                                                <i class="fa-solid fa-circle-xmark mr-2"></i>
                                            
                                            <% } else if (order.status === 'Out for Delivery') { %>
                                            
                                                <i class="fa-solid fa-truck mr-2"></i>
                                            
                                            <% } else if (order.status === 'Baking') { %>
                                            
                                                <i class="fa-solid fa-fire mr-2"></i>
                                            
                                            <% } else { %>
                                            
                                                <i class="fa-solid fa-clock mr-2"></i>
                                            
                                            <% } %>
                                            
                                            <%= order.status %>
                                            
                                        </span>
                                    
                                    
                                        <!-- PAYMENT STATUS -->
                                    
                                        <div class="flex items-center gap-2 mt-3 lg:justify-end">
                                        
                                            <span class="text-sm text-[#8B7765]">
                                            
                                                <%= order.paymentMethod === 'cod'
                                                    ? 'Cash on Delivery'
                                                    : 'Online Payment'
                                                %>
                                            
                                            </span>
                                        
                                            <span
                                                class="
                                                    px-2.5 py-1 rounded-full text-xs font-semibold
                                        
                                                    <%= order.paymentStatus === 'Paid'
                                                        ? 'bg-green-100 text-green-700'
                                                        : 'bg-yellow-100 text-yellow-700'
                                                    %>
                                                "
                                            >
                                        
                                                <%= order.paymentStatus %>
                                        
                                            </span>
                                        
                                        </div>
                                    
                                    </div>
                                
                                </div>
                            
                            </div>
                        
                        
                            <!-- CANCELLED MESSAGE -->
                        
                            <% if (order.status === 'Cancelled') { %>
                            
                                <div class="bg-red-50 border-b border-red-200 px-8 py-4 flex items-start gap-4">
                                
                                    <i class="fa-solid fa-circle-xmark text-red-500 text-xl mt-1"></i>
                                
                                    <div>
                                    
                                        <p class="font-semibold text-red-700">
                                            This order has been cancelled.
                                        </p>
                                    
                                        <p class="text-sm text-red-600 mt-1">
                                            This order will not be prepared or delivered.
                                        </p>
                                    
                                    </div>
                                
                                </div>
                            
                            <% } %>
                            
                            
                            <!-- PRODUCTS -->
                            
                            <div
                                class="
                                    px-8 py-6
                                    <%= order.status === 'Cancelled' ? 'opacity-60' : '' %>
                                "
                            >
                            
                                <p class="text-xs uppercase tracking-widest text-[#8B7765] mb-5">
                                    Order Items
                                </p>
                            
                                <div class="space-y-5">
                                
                                    <% order.products.slice(0, 3).forEach(item => { %>
                                    
                                        <div class="flex items-center justify-between gap-5">
                                        
                                            <div class="flex items-center gap-4 min-w-0">
                                            
                                                <div
                                                    class="w-16 h-16 rounded-xl bg-[#E8DCCB] shrink-0"
                                                    <% if (item.product?.image) { %>
                                                        style="background-image:url('<%= item.product.image %>');background-size:cover;background-position:center;"
                                                    <% } %>
                                                ></div>
                                                    
                                                <div class="min-w-0">
                                                
                                                    <p class="font-medium truncate">
                                                        <%= item.product?.name || 'Product unavailable' %>
                                                    </p>
                                                
                                                    <p class="text-sm text-[#6B5B50] mt-1">
                                                        Qty: <%= item.quantity %>
                                                    </p>
                                                
                                                    <p class="text-xs text-[#8B7765] mt-1">
                                                        ₹<%= item.orderPrice %> each
                                                    </p>
                                                
                                                </div>
                                            
                                            </div>
                                        
                                            <p class="font-semibold shrink-0">
                                                ₹<%= item.orderPrice * item.quantity %>
                                            </p>
                                        
                                        </div>
                                    
                                    <% }) %>
                                    
                                    
                                    <% if (order.products.length > 3) { %>
                                    
                                        <p class="text-sm text-[#6B5B50] pt-1">
                                            + <%= order.products.length - 3 %> more item(s)
                                        </p>
                                    
                                    <% } %>
                                    
                                </div>
                            
                            </div>
                        
                        
                            <!-- ORDER SUMMARY -->
                        
                            <div class="px-8 py-6 border-t border-[#E8DCCB] bg-[#FAF7F2]">
                            
                                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
                                
                                    <!-- PRICE BREAKDOWN -->
                                
                                    <div class="space-y-2 min-w-64">
                                    
                                        <div class="flex justify-between gap-12 text-sm text-[#6B5B50]">
                                        
                                            <span>Subtotal</span>
                                        
                                            <span>₹<%= order.subtotal %></span>
                                        
                                        </div>
                                    
                                        <div class="flex justify-between gap-12 text-sm text-[#6B5B50]">
                                        
                                            <span>Delivery Fee</span>
                                        
                                            <span>₹<%= order.deliveryFee %></span>
                                        
                                        </div>
                                    
                                        <div class="flex justify-between gap-12 pt-3 mt-2 border-t border-[#E8DCCB]">
                                        
                                            <span class="font-semibold text-[#4A3428]">
                                                Total
                                            </span>
                                        
                                            <span class="font-bold text-2xl">
                                                ₹<%= order.total %>
                                            </span>
                                        
                                        </div>
                                    
                                    </div>
                                
                                
                                    <!-- ACTIONS -->
                                
                                    <div class="flex flex-wrap gap-3">
                                    
                                        <!-- VIEW DETAILS -->
                                    
                                        <a
                                            href="/orders/<%= order._id %>"
                                            class="px-6 py-3 rounded-xl bg-[#C9A36B] hover:bg-[#B89056] font-semibold transition"
                                        >
                                            <i class="fa-solid fa-eye mr-2"></i>
                                            View Details
                                        </a>
                                    
                                    
                                        <!-- CANCEL -->
                                    
                                        <% if (['Preparing', 'Baking'].includes(order.status)) { %>
                                        
                                            <button
                                                type="button"
                                                class="cancel-order px-6 py-3 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 transition"
                                                data-id="<%= order._id %>"
                                            >
                                                <i class="fa-solid fa-xmark mr-2"></i>
                                                Cancel Order
                                            </button>
                                        
                                        <% } %>
                                        
                                        
                                        <!-- REORDER -->
                                        
                                        <% if (['Delivered', 'Cancelled'].includes(order.status)) { %>
                                        
                                            <button
                                                type="button"
                                                class="reorder px-6 py-3 rounded-xl border border-[#E8DCCB] hover:bg-white transition"
                                                data-id="<%= order._id %>"
                                            >
                                                <i class="fa-solid fa-rotate-right mr-2"></i>
                                                Reorder
                                            </button>
                                        
                                        <% } %>
                                        
                                        
                                        <!-- TRACK -->
                                        
                                        <% if (order.status === 'Out for Delivery') { %>
                                        
                                            <a
                                                href="/orders/<%= order._id %>"
                                                class="px-6 py-3 rounded-xl border border-[#E8DCCB] hover:bg-white transition"
                                            >
                                                <i class="fa-solid fa-location-dot mr-2"></i>
                                                Track Order
                                            </a>
                                        
                                        <% } %>
                                        
                                    </div>
                                
                                </div>
                            
                            </div>
                        
                        
                            <!-- ORDER NOTES -->
                        
                            <% if (order.orderNotes) { %>
                            
                                <div class="px-8 py-5 border-t border-[#E8DCCB] flex items-start gap-4">
                                
                                    <i class="fa-solid fa-note-sticky text-[#C9A36B] mt-1"></i>
                                
                                    <div>
                                    
                                        <p class="text-xs uppercase tracking-widest text-[#8B7765]">
                                            Order Note
                                        </p>
                                    
                                        <p class="text-sm text-[#6B5B50] mt-1">
                                            <%= order.orderNotes %>
                                        </p>
                                    
                                    </div>
                                
                                </div>
                            
                            <% } %>
                            
                        </article>
                    
                    <% }) %>
                    
                <% } else { %>
                
                    <!-- NO ORDERS -->
                
                    <div class="bg-white border border-[#E8DCCB] rounded-3xl py-20 text-center">
                    
                        <div class="w-20 h-20 mx-auto rounded-full bg-[#F8EFD8] flex items-center justify-center">
                        
                            <i class="fa-solid fa-bag-shopping text-3xl text-[#C9A36B]"></i>
                        
                        </div>
                    
                        <h2 class="font-serif text-3xl mt-6">
                            No Orders Yet
                        </h2>
                    
                        <p class="text-[#8B7765] mt-2">
                            Your orders will appear here once you place your first order.
                        </p>
                    
                        <a
                            href="/menu"
                            class="inline-flex items-center gap-2 mt-6 bg-[#C9A36B] hover:bg-[#B89056] px-6 py-3 rounded-xl font-semibold transition"
                        >
                            <i class="fa-solid fa-store"></i>
                            Browse Menu
                        </a>
                    
                    </div>
                
                <% } %>
                
            </div>
        
        </section>

    <% } %>
    
    <%- include('./loadAnimation')%>

    <script src="/scripts/load.js"></script>
    <script src="/scripts/orders.js" type="module"></script>


</body>

</html>