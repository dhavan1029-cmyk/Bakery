<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Settings | FLOURish Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>


<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen">


<!-- MOBILE HEADER -->

<header
    class="lg:hidden bg-white border-b border-[#E8DCCB]
           h-16 px-5 flex items-center justify-between"
>

    <a
        href="/admin/dashboard"
        class="flex items-center gap-2"
    >

        <i
            class="fa-solid fa-wheat-awn
                   text-2xl text-[#C9A36B]"
        ></i>

        <h1 class="font-serif text-2xl">

            FLOUR<span class="italic text-[#C9A36B]">ish</span>

        </h1>

    </a>


    <button
        id="mobile-menu-button"
        class="w-10 h-10 rounded-xl
               hover:bg-[#F8F4EE]"
    >

        <i class="fa-solid fa-bars"></i>

    </button>

</header>



<!-- SIDEBAR -->

<aside
    id="sidebar"
    class="fixed left-0 top-0 bottom-0 w-64
           bg-white border-r border-[#E8DCCB]
           z-50 -translate-x-full lg:translate-x-0
           transition-transform duration-300"
>


    <!-- LOGO -->

    <div
        class="h-20 px-6 flex items-center
               border-b border-[#E8DCCB]"
    >

        <a
            href="/admin/dashboard"
            class="flex items-center gap-3"
        >

            <i
                class="fa-solid fa-wheat-awn
                       text-3xl text-[#C9A36B]"
            ></i>

            <h1 class="font-serif text-3xl">

                FLOUR<span class="italic text-[#C9A36B]">ish</span>

            </h1>

        </a>

    </div>



    <!-- NAVIGATION -->

    <nav class="p-4 space-y-2">


        <p
            class="text-xs uppercase tracking-widest
                   text-[#A18D7B] px-3 mb-3"
        >
            Management
        </p>


        <a
            href="/admin/dashboard"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-chart-line
                       w-5 text-[#8B7765]"
            ></i>

            Dashboard

        </a>


        <a
            href="/admin/orders"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-bag-shopping
                       w-5 text-[#8B7765]"
            ></i>

            Orders

        </a>


        <a
            href="/admin/products"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-box
                       w-5 text-[#8B7765]"
            ></i>

            Products

        </a>


        <a
            href="/admin/customers"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-users
                       w-5 text-[#8B7765]"
            ></i>

            Customers

        </a>



        <!-- ACCOUNT -->

        <div class="pt-5">

            <p
                class="text-xs uppercase tracking-widest
                       text-[#A18D7B] px-3 mb-3"
            >
                Account
            </p>


            <a
                href="/admin/account"
                class="flex items-center gap-3
                       px-4 py-3 rounded-xl
                       hover:bg-[#F8F4EE] transition"
            >

                <i
                    class="fa-solid fa-user-shield
                           w-5 text-[#8B7765]"
                ></i>

                Profile

            </a>


            <a
                href="/admin/settings"
                class="flex items-center gap-3
                       px-4 py-3 rounded-xl
                       bg-[#F8EFD8] font-semibold"
            >

                <i
                    class="fa-solid fa-gear
                           w-5 text-[#C9A36B]"
                ></i>

                Settings

            </a>

        </div>



        <!-- WEBSITE -->

        <div class="pt-5">

            <a
                href="/"
                class="flex items-center gap-3
                       px-4 py-3 rounded-xl
                       hover:bg-[#F8F4EE] transition"
            >

                <i
                    class="fa-solid fa-arrow-up-right-from-square
                           w-5 text-[#8B7765]"
                ></i>

                View Website

            </a>

        </div>

    </nav>



    <!-- ADMIN -->

    <div
        class="absolute bottom-0 left-0 right-0
               p-4 border-t border-[#E8DCCB]"
    >

        <div class="flex items-center gap-3 px-3 py-3">

            <div
                class="w-10 h-10 rounded-full
                       bg-[#F8EFD8]
                       flex items-center justify-center"
            >

                <i
                    class="fa-solid fa-user-shield
                           text-[#C9A36B]"
                ></i>

            </div>


            <div>

                <p class="font-semibold text-sm">

                    <%= admin?.username || "Admin" %>

                </p>

                <p class="text-xs text-[#8B7765]">
                    Administrator
                </p>

            </div>

        </div>


        <form
            action="/admin/logout"
            method="POST"
        >

            <button
                type="submit"
                class="w-full flex items-center gap-3
                       px-4 py-3 rounded-xl
                       text-red-600 hover:bg-red-50
                       transition"
            >

                <i
                    class="fa-solid fa-right-from-bracket w-5"
                ></i>

                Logout

            </button>

        </form>

    </div>

</aside>



<!-- MOBILE OVERLAY -->

<div
    id="sidebar-overlay"
    class="fixed inset-0 bg-black/30
           z-40 hidden lg:hidden"
></div>



<!-- MAIN -->

<main class="lg:ml-64 min-h-screen">


    <!-- DESKTOP HEADER -->

    <header
        class="hidden lg:flex h-20 bg-white
               border-b border-[#E8DCCB]
               px-8 items-center justify-between"
    >

        <div>

            <p class="text-sm text-[#8B7765]">
                Administration
            </p>

            <h2 class="font-serif text-2xl">
                Settings
            </h2>

        </div>


        <div class="flex items-center gap-3">

            <div
                class="w-10 h-10 rounded-full
                       bg-[#F8EFD8]
                       flex items-center justify-center"
            >

                <i
                    class="fa-solid fa-user-shield
                           text-[#C9A36B]"
                ></i>

            </div>


            <div>

                <p class="font-semibold text-sm">

                    <%= admin?.username || "Admin" %>

                </p>

                <p class="text-xs text-[#8B7765]">
                    Administrator
                </p>

            </div>

        </div>

    </header>



    <!-- CONTENT -->

    <section
        class="p-5 sm:p-8 max-w-5xl mx-auto"
    >


        <!-- PAGE TITLE -->

        <div class="mb-8">

            <p class="text-[#8B7765]">
                Configure your bakery
            </p>

            <h1 class="font-serif text-4xl sm:text-5xl mt-1">
                Settings
            </h1>

        </div>



        <!-- SUCCESS -->

        <% if(success){ %>

            <div
                class="mb-6 bg-green-50
                       border border-green-200
                       text-green-700
                       rounded-xl px-4 py-3"
            >

                <div class="flex items-center gap-3">

                    <i class="fa-solid fa-circle-check"></i>

                    <p>
                        <%= success %>
                    </p>

                </div>

            </div>

        <% } %>



        <!-- ERROR -->

        <% if(error){ %>

            <div
                class="mb-6 bg-red-50
                       border border-red-200
                       text-red-700
                       rounded-xl px-4 py-3"
            >

                <div class="flex items-center gap-3">

                    <i
                        class="fa-solid fa-circle-exclamation"
                    ></i>

                    <p>
                        <%= error %>
                    </p>

                </div>

            </div>

        <% } %>



        <form
            action="/admin/settings"
            method="POST"
            class="space-y-6"
        >


            <!-- STORE INFORMATION -->

            <section
                class="bg-white border border-[#E8DCCB]
                       rounded-3xl shadow-sm p-6 sm:p-8"
            >

                <div
                    class="flex items-start gap-4 mb-7"
                >

                    <div
                        class="w-12 h-12 rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center
                               shrink-0"
                    >

                        <i
                            class="fa-solid fa-store
                                   text-xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <div>

                        <h2 class="font-serif text-2xl">
                            Store Information
                        </h2>

                        <p
                            class="text-sm text-[#6B5B50]
                                   mt-1"
                        >
                            Information displayed to your customers.
                        </p>

                    </div>

                </div>



                <div class="grid md:grid-cols-2 gap-5">


                    <!-- STORE NAME -->

                    <div>

                        <label
                            for="storeName"
                            class="block mb-2 font-medium"
                        >
                            Bakery Name
                        </label>

                        <input
                            id="storeName"
                            type="text"
                            name="storeName"
                            required
                            value="<%= settings?.storeName || 'FLOURish Bakery' %>"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >

                    </div>



                    <!-- EMAIL -->

                    <div>

                        <label
                            for="storeEmail"
                            class="block mb-2 font-medium"
                        >
                            Contact Email
                        </label>

                        <input
                            id="storeEmail"
                            type="email"
                            name="storeEmail"
                            required
                            value="<%= settings?.storeEmail || '' %>"
                            placeholder="bakery@example.com"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >

                    </div>



                    <!-- PHONE -->

                    <div>

                        <label
                            for="storePhone"
                            class="block mb-2 font-medium"
                        >
                            Phone Number
                        </label>

                        <input
                            id="storePhone"
                            type="tel"
                            name="storePhone"
                            value="<%= settings?.storePhone || '' %>"
                            placeholder="Enter phone number"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >

                    </div>



                    <!-- ADDRESS -->

                    <div>

                        <label
                            for="storeAddress"
                            class="block mb-2 font-medium"
                        >
                            Bakery Address
                        </label>

                        <input
                            id="storeAddress"
                            type="text"
                            name="storeAddress"
                            value="<%= settings?.storeAddress || '' %>"
                            placeholder="Enter bakery address"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >

                    </div>

                </div>

            </section>



            <!-- ORDER SETTINGS -->

            <section
                class="bg-white border border-[#E8DCCB]
                       rounded-3xl shadow-sm p-6 sm:p-8"
            >

                <div
                    class="flex items-start gap-4 mb-7"
                >

                    <div
                        class="w-12 h-12 rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center
                               shrink-0"
                    >

                        <i
                            class="fa-solid fa-bag-shopping
                                   text-xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <div>

                        <h2 class="font-serif text-2xl">
                            Order Settings
                        </h2>

                        <p
                            class="text-sm text-[#6B5B50]
                                   mt-1"
                        >
                            Control how customers place orders.
                        </p>

                    </div>

                </div>



                <div class="grid md:grid-cols-2 gap-5">


                    <!-- DELIVERY FEE -->

                    <div>

                        <label
                            for="deliveryFee"
                            class="block mb-2 font-medium"
                        >
                            Delivery Fee
                        </label>

                        <div class="relative">

                            <span
                                class="absolute left-4 top-1/2
                                       -translate-y-1/2
                                       text-[#8B7765]"
                            >
                                ₹
                            </span>

                            <input
                                id="deliveryFee"
                                type="number"
                                name="deliveryFee"
                                min="0"
                                step="1"
                                required
                                value="<%= settings?.deliveryFee ?? 50 %>"
                                class="w-full border border-[#E8DCCB]
                                       rounded-xl pl-9 pr-4 py-3
                                       outline-none
                                       focus:border-[#C9A36B]"
                            >

                        </div>

                    </div>



                    <!-- MINIMUM ORDER -->

                    <div>

                        <label
                            for="minimumOrder"
                            class="block mb-2 font-medium"
                        >
                            Minimum Order Amount
                        </label>

                        <div class="relative">

                            <span
                                class="absolute left-4 top-1/2
                                       -translate-y-1/2
                                       text-[#8B7765]"
                            >
                                ₹
                            </span>

                            <input
                                id="minimumOrder"
                                type="number"
                                name="minimumOrder"
                                min="0"
                                step="1"
                                value="<%= settings?.minimumOrder ?? 0 %>"
                                class="w-full border border-[#E8DCCB]
                                       rounded-xl pl-9 pr-4 py-3
                                       outline-none
                                       focus:border-[#C9A36B]"
                            >

                        </div>

                    </div>



                    <!-- DELIVERY TIME -->

                    <div>

                        <label
                            for="deliveryTime"
                            class="block mb-2 font-medium"
                        >
                            Estimated Delivery Time
                        </label>

                        <select
                            id="deliveryTime"
                            name="deliveryTime"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   bg-white outline-none
                                   focus:border-[#C9A36B]"
                        >

                            <option
                                value="30-45"
                                <%= settings?.deliveryTime === '30-45' ? 'selected' : '' %>
                            >
                                30–45 minutes
                            </option>

                            <option
                                value="45-60"
                                <%= settings?.deliveryTime === '45-60' ? 'selected' : '' %>
                            >
                                45–60 minutes
                            </option>

                            <option
                                value="60-90"
                                <%= settings?.deliveryTime === '60-90' ? 'selected' : '' %>
                            >
                                60–90 minutes
                            </option>

                            <option
                                value="90-120"
                                <%= settings?.deliveryTime === '90-120' ? 'selected' : '' %>
                            >
                                90–120 minutes
                            </option>

                        </select>

                    </div>



                    <!-- MAX ORDER -->

                    <div>

                        <label
                            for="defaultMaxOrder"
                            class="block mb-2 font-medium"
                        >
                            Default Maximum Order
                        </label>

                        <input
                            id="defaultMaxOrder"
                            type="number"
                            name="defaultMaxOrder"
                            min="1"
                            step="1"
                            value="<%= settings?.defaultMaxOrder ?? 10 %>"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >

                    </div>

                </div>

            </section>



            <!-- WEBSITE STATUS -->

            <section
                class="bg-white border border-[#E8DCCB]
                       rounded-3xl shadow-sm p-6 sm:p-8"
            >

                <div
                    class="flex items-start gap-4 mb-7"
                >

                    <div
                        class="w-12 h-12 rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center
                               shrink-0"
                    >

                        <i
                            class="fa-solid fa-power-off
                                   text-xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <div>

                        <h2 class="font-serif text-2xl">
                            Website & Ordering
                        </h2>

                        <p
                            class="text-sm text-[#6B5B50]
                                   mt-1"
                        >
                            Control whether customers can place orders.
                        </p>

                    </div>

                </div>



                <div class="space-y-4">


                    <!-- STORE OPEN -->

                    <label
                        class="flex items-center justify-between
                               gap-5 p-4 rounded-2xl
                               border border-[#E8DCCB]
                               cursor-pointer
                               hover:bg-[#F8F4EE]"
                    >

                        <div>

                            <p class="font-semibold">
                                Store Open
                            </p>

                            <p
                                class="text-sm text-[#8B7765]
                                       mt-1"
                            >
                                Customers can browse the bakery.
                            </p>

                        </div>


                        <input
                            type="checkbox"
                            name="storeOpen"
                            value="true"
                            <%= settings?.storeOpen !== false ? 'checked' : '' %>
                            class="w-5 h-5 accent-[#C9A36B]"
                        >

                    </label>



                    <!-- ACCEPT ORDERS -->

                    <label
                        class="flex items-center justify-between
                               gap-5 p-4 rounded-2xl
                               border border-[#E8DCCB]
                               cursor-pointer
                               hover:bg-[#F8F4EE]"
                    >

                        <div>

                            <p class="font-semibold">
                                Accept Orders
                            </p>

                            <p
                                class="text-sm text-[#8B7765]
                                       mt-1"
                            >
                                Allow customers to add products
                                and place new orders.
                            </p>

                        </div>


                        <input
                            type="checkbox"
                            name="acceptOrders"
                            value="true"
                            <%= settings?.acceptOrders !== false ? 'checked' : '' %>
                            class="w-5 h-5 accent-[#C9A36B]"
                        >

                    </label>



                    <!-- MAINTENANCE -->

                    <label
                        class="flex items-center justify-between
                               gap-5 p-4 rounded-2xl
                               border border-red-200
                               bg-red-50
                               cursor-pointer"
                    >

                        <div>

                            <p class="font-semibold text-red-700">
                                Maintenance Mode
                            </p>

                            <p
                                class="text-sm text-red-600/80
                                       mt-1"
                            >
                                Temporarily prevent customers
                                from using the website.
                            </p>

                        </div>


                        <input
                            type="checkbox"
                            name="maintenanceMode"
                            value="true"
                            <%= settings?.maintenanceMode ? 'checked' : '' %>
                            class="w-5 h-5 accent-red-600"
                        >

                    </label>

                </div>

            </section>



            <!-- SECURITY -->

            <section
                class="bg-white border border-[#E8DCCB]
                       rounded-3xl shadow-sm p-6 sm:p-8"
            >

                <div
                    class="flex items-start gap-4"
                >

                    <div
                        class="w-12 h-12 rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center
                               shrink-0"
                    >

                        <i
                            class="fa-solid fa-shield-halved
                                   text-xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <div class="flex-1">

                        <h2 class="font-serif text-2xl">
                            Security
                        </h2>

                        <p
                            class="text-sm text-[#6B5B50]
                                   mt-1"
                        >
                            Manage your administrator account security.
                        </p>


                        <a
                            href="/admin/profile/change-password"
                            class="inline-flex items-center gap-2
                                   mt-5 border border-[#E8DCCB]
                                   rounded-xl px-4 py-3
                                   hover:bg-[#F8F4EE]
                                   transition"
                        >

                            <i class="fa-solid fa-key"></i>

                            Change Password

                        </a>

                    </div>

                </div>

            </section>



            <!-- SAVE -->

            <div
                class="flex flex-col-reverse
                       sm:flex-row justify-end gap-3"
            >

                <a
                    href="/admin/dashboard"
                    class="flex items-center
                           justify-center gap-2
                           border border-[#E8DCCB]
                           rounded-xl px-6 py-3
                           hover:bg-white transition"
                >

                    Cancel

                </a>


                <button
                    type="submit"
                    class="flex items-center
                           justify-center gap-2
                           bg-[#C9A36B]
                           hover:bg-[#B89056]
                           text-[#2F241D]
                           font-semibold
                           rounded-xl px-6 py-3
                           transition"
                >

                    <i class="fa-solid fa-floppy-disk"></i>

                    Save Settings

                </button>

            </div>


        </form>



        <!-- DANGER ZONE -->

        <section
            class="mt-8 bg-white border border-red-200
                   rounded-3xl shadow-sm p-6 sm:p-8"
        >

            <div class="flex items-start gap-4">

                <div
                    class="w-12 h-12 rounded-full
                           bg-red-100 flex items-center
                           justify-center shrink-0"
                >

                    <i
                        class="fa-solid fa-triangle-exclamation
                               text-red-600"
                    ></i>

                </div>


                <div class="flex-1">

                    <h2 class="font-serif text-2xl text-red-700">
                        Danger Zone
                    </h2>

                    <p
                        class="text-sm text-[#6B5B50]
                               mt-1"
                    >
                        These actions can affect how your bakery operates.
                    </p>


                    <div
                        class="mt-5 p-4 rounded-2xl
                               border border-red-200
                               bg-red-50"
                    >

                        <p class="font-semibold text-red-700">
                            Disable ordering
                        </p>

                        <p
                            class="text-sm text-red-600/80
                                   mt-1"
                        >
                            Use the "Accept Orders" option above
                            instead of permanently deleting or
                            disabling your store.
                        </p>

                    </div>

                </div>

            </div>

        </section>


    </section>

</main>



<!-- MOBILE SIDEBAR -->

<script>

    const sidebar =
        document.querySelector('#sidebar')

    const mobileMenuButton =
        document.querySelector('#mobile-menu-button')

    const sidebarOverlay =
        document.querySelector('#sidebar-overlay')


    mobileMenuButton?.addEventListener('click', () => {

        sidebar.classList.toggle(
            '-translate-x-full'
        )

        sidebarOverlay.classList.toggle(
            'hidden'
        )

    })


    sidebarOverlay?.addEventListener('click', () => {

        sidebar.classList.add(
            '-translate-x-full'
        )

        sidebarOverlay.classList.add(
            'hidden'
        )

    })

</script>


</body>

</html>