<div
    id="updateToast"
    class="fixed top-5 left-1/2 -translate-x-1/2 z-50 w-[min(92vw,500px)] overflow-hidden rounded-2xl border border-[#5A4638] bg-[#30251E] text-white shadow-[0_20px_60px_rgba(0,0,0,0.3)] transition-all duration-500 transform translate-y-[-30vh]"
>

    <div class="relative px-5 py-5">

        <!-- Accent -->
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#D89A68]"></div>


        <div class="flex items-start gap-4">

            <!-- ICON -->

            <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#D89A68]/15 border border-[#D89A68]/20"
            >

                <i class="fa-solid fa-bell text-[#E6A875] text-lg"></i>

            </div>


            <!-- CONTENT -->

            <div class="min-w-0 flex-1">

                <div class="flex items-center gap-2">

                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#D89A68]">
                        Admin Notification
                    </p>

                    <span class="h-1 w-1 rounded-full bg-[#8B7765]"></span>

                    <span class="text-[11px] text-[#A18D7B]">
                        Just now
                    </span>

                </div>


                <p
                    id="toastMessage"
                    class="mt-1.5 pr-2 text-sm font-semibold leading-6 text-[#FFF9F3]"
                >
                    Order #67a91 cancelled — Tyler Durden cancelled their order.
                </p>


                <button
                    type="button"
                    class="mt-3 text-xs font-semibold text-[#D89A68] hover:text-[#E6A875] transition"
                >
                    View Order
                    <i class="fa-solid fa-arrow-right ml-1 text-[10px]"></i>
                </button>

            </div>


            <!-- CLOSE -->

            <button
                type="button"
                onclick="hideToast()"
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[#A18D7B] hover:bg-white/10 hover:text-white transition"
            >

                <i class="fa-solid fa-xmark text-sm"></i>

            </button>

        </div>

    </div>


    <!-- PROGRESS -->

    <div class="h-1 bg-white/5">

        <div
            id="toastProgress"
            class="h-full w-full origin-left bg-[#D89A68] transition-transform duration-100"
        ></div>

    </div>

</div>

<script>
    const updateToast = document.querySelector('#updateToast')

    const updates = []
    let isShowingUpdates = false

    function showToast(message) {
        updateToast.textContent = message
        updateToast.classList.remove('translate-y-[-30vh]')
    }

    function hideToast() {
        updateToast.classList.add('translate-y-[-30vh]')
    }

    function wait(ms) {
        return new Promise(resolve => setTimeout(resolve, ms))
    }

    const showUpdate = (() => {
        const updates = []
        let isShowingUpdates = false
        
        return async function (message) {
            updates.push(message)
        
            if (isShowingUpdates) return
        
            isShowingUpdates = true
        
            while (updates.length > 0) {
                const update = updates.shift()
            
                showToast(update)
            
                await wait(3000)
            
                hideToast()
            
                await wait(300)
            }
        
            isShowingUpdates = false
        }
    })()
</script>