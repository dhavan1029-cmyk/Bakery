<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Change Password | FLOURish Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>


<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen">


<!-- MOBILE HEADER -->

<header
    class="lg:hidden bg-white border-b border-[#E8DCCB]
           h-16 px-5 flex items-center justify-between"
>

    <a
        href="/admin/dashboard"
        class="flex items-center gap-2"
    >

        <i
            class="fa-solid fa-wheat-awn
                   text-2xl text-[#C9A36B]"
        ></i>

        <h1 class="font-serif text-2xl">

            FLOUR<span class="italic text-[#C9A36B]">ish</span>

        </h1>

    </a>


    <button
        id="mobile-menu-button"
        class="w-10 h-10 rounded-xl
               hover:bg-[#F8F4EE]"
    >

        <i class="fa-solid fa-bars"></i>

    </button>

</header>



<!-- SIDEBAR -->

<aside
    id="sidebar"
    class="fixed left-0 top-0 bottom-0 w-64
           bg-white border-r border-[#E8DCCB]
           z-50 -translate-x-full lg:translate-x-0
           transition-transform duration-300"
>


    <!-- LOGO -->

    <div
        class="h-20 px-6 flex items-center
               border-b border-[#E8DCCB]"
    >

        <a
            href="/admin/dashboard"
            class="flex items-center gap-3"
        >

            <i
                class="fa-solid fa-wheat-awn
                       text-3xl text-[#C9A36B]"
            ></i>

            <h1 class="font-serif text-3xl">

                FLOUR<span class="italic text-[#C9A36B]">ish</span>

            </h1>

        </a>

    </div>



    <!-- NAVIGATION -->

    <nav class="p-4 space-y-2">


        <p
            class="text-xs uppercase tracking-widest
                   text-[#A18D7B] px-3 mb-3"
        >
            Management
        </p>


        <a
            href="/admin/dashboard"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-chart-line
                       w-5 text-[#8B7765]"
            ></i>

            Dashboard

        </a>


        <a
            href="/admin/orders"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-bag-shopping
                       w-5 text-[#8B7765]"
            ></i>

            Orders

        </a>


        <a
            href="/admin/products"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-box
                       w-5 text-[#8B7765]"
            ></i>

            Products

        </a>


        <a
            href="/admin/customers"
            class="flex items-center gap-3
                   px-4 py-3 rounded-xl
                   hover:bg-[#F8F4EE] transition"
        >

            <i
                class="fa-solid fa-users
                       w-5 text-[#8B7765]"
            ></i>

            Customers

        </a>



        <!-- ACCOUNT -->

        <div class="pt-5">

            <p
                class="text-xs uppercase tracking-widest
                       text-[#A18D7B] px-3 mb-3"
            >
                Account
            </p>


            <a
                href="/admin/profile"
                class="flex items-center gap-3
                       px-4 py-3 rounded-xl
                       bg-[#F8EFD8] font-semibold"
            >

                <i
                    class="fa-solid fa-user-shield
                           w-5 text-[#C9A36B]"
                ></i>

                Profile

            </a>

        </div>



        <!-- WEBSITE -->

        <div class="pt-5">

            <p
                class="text-xs uppercase tracking-widest
                       text-[#A18D7B] px-3 mb-3"
            >
                Website
            </p>


            <a
                href="/"
                class="flex items-center gap-3
                       px-4 py-3 rounded-xl
                       hover:bg-[#F8F4EE] transition"
            >

                <i
                    class="fa-solid fa-arrow-up-right-from-square
                           w-5 text-[#8B7765]"
                ></i>

                View Website

            </a>

        </div>

    </nav>



    <!-- ADMIN -->

    <div
        class="absolute bottom-0 left-0 right-0
               p-4 border-t border-[#E8DCCB]"
    >

        <div class="flex items-center gap-3 px-3 py-3">

            <div
                class="w-10 h-10 rounded-full
                       bg-[#F8EFD8]
                       flex items-center justify-center"
            >

                <i
                    class="fa-solid fa-user-shield
                           text-[#C9A36B]"
                ></i>

            </div>


            <div>

                <p class="font-semibold text-sm">

                    <%= admin?.username || "Admin" %>

                </p>

                <p class="text-xs text-[#8B7765]">

                    Administrator

                </p>

            </div>

        </div>


        <form
            action="/admin/logout"
            method="POST"
        >

            <button
                type="submit"
                class="w-full flex items-center gap-3
                       px-4 py-3 rounded-xl
                       text-red-600 hover:bg-red-50
                       transition"
            >

                <i
                    class="fa-solid fa-right-from-bracket w-5"
                ></i>

                Logout

            </button>

        </form>

    </div>

</aside>



<!-- MOBILE OVERLAY -->

<div
    id="sidebar-overlay"
    class="fixed inset-0 bg-black/30
           z-40 hidden lg:hidden"
></div>



<!-- MAIN -->

<main class="lg:ml-64 min-h-screen">


    <!-- DESKTOP HEADER -->

    <header
        class="hidden lg:flex h-20 bg-white
               border-b border-[#E8DCCB]
               px-8 items-center justify-between"
    >

        <div>

            <p class="text-sm text-[#8B7765]">
                Account
            </p>

            <h2 class="font-serif text-2xl">
                Change Password
            </h2>

        </div>


        <div class="flex items-center gap-3">

            <div
                class="w-10 h-10 rounded-full
                       bg-[#F8EFD8]
                       flex items-center justify-center"
            >

                <i
                    class="fa-solid fa-user-shield
                           text-[#C9A36B]"
                ></i>

            </div>


            <div>

                <p class="font-semibold text-sm">

                    <%= admin?.username || "Admin" %>

                </p>

                <p class="text-xs text-[#8B7765]">
                    Administrator
                </p>

            </div>

        </div>

    </header>



    <!-- CONTENT -->

    <section
        class="p-5 sm:p-8 max-w-4xl mx-auto"
    >


        <!-- PAGE TITLE -->

        <div class="mb-8">

            <p class="text-[#8B7765]">
                Update your administrator credentials
            </p>

            <h1 class="font-serif text-4xl sm:text-5xl mt-1">
                Change Password
            </h1>

        </div>



        <!-- PASSWORD CARD -->

        <div
            class="bg-white border border-[#E8DCCB]
                   rounded-3xl shadow-sm p-6 sm:p-8"
        >


            <!-- ERROR -->

            <% if(error){ %>

                <div
                    class="mb-6 bg-red-50
                           border border-red-200
                           text-red-700
                           rounded-xl px-4 py-3"
                >

                    <div class="flex items-start gap-3">

                        <i
                            class="fa-solid fa-circle-exclamation
                                   mt-0.5"
                        ></i>

                        <p>
                            <%= error %>
                        </p>

                    </div>

                </div>

            <% } %>



            <!-- SUCCESS -->

            <% if(success){ %>

                <div
                    class="mb-6 bg-green-50
                           border border-green-200
                           text-green-700
                           rounded-xl px-4 py-3"
                >

                    <div class="flex items-start gap-3">

                        <i
                            class="fa-solid fa-circle-check
                                   mt-0.5"
                        ></i>

                        <p>
                            <%= success %>
                        </p>

                    </div>

                </div>

            <% } %>



            <!-- INTRO -->

            <div
                class="flex items-start gap-4
                       mb-8"
            >

                <div
                    class="w-12 h-12 rounded-full
                           bg-[#F8EFD8]
                           flex items-center justify-center
                           shrink-0"
                >

                    <i
                        class="fa-solid fa-lock
                               text-xl text-[#C9A36B]"
                    ></i>

                </div>


                <div>

                    <h2 class="font-serif text-2xl">
                        Update your password
                    </h2>

                    <p
                        class="text-sm text-[#6B5B50]
                               mt-1"
                    >
                        Enter your current password and
                        choose a new password for your
                        administrator account.
                    </p>

                </div>

            </div>



            <!-- FORM -->

            <form
                action="/admin/profile/change-password"
                method="POST"
                id="change-password-form"
                class="space-y-6"
            >


                <!-- CURRENT PASSWORD -->

                <div>

                    <label
                        for="currentPassword"
                        class="block mb-2 font-medium"
                    >

                        Current Password

                    </label>


                    <div class="relative">

                        <input
                            id="currentPassword"
                            type="password"
                            name="currentPassword"
                            required
                            autocomplete="current-password"
                            placeholder="Enter your current password"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3 pr-12
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >


                        <button
                            type="button"
                            class="password-toggle
                                   absolute right-4 top-1/2
                                   -translate-y-1/2
                                   text-[#8B7765]"
                            data-target="currentPassword"
                        >

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                </div>



                <!-- NEW PASSWORD -->

                <div>

                    <label
                        for="newPassword"
                        class="block mb-2 font-medium"
                    >

                        New Password

                    </label>


                    <div class="relative">

                        <input
                            id="newPassword"
                            type="password"
                            name="newPassword"
                            required
                            minlength="6"
                            autocomplete="new-password"
                            placeholder="Enter your new password"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3 pr-12
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >


                        <button
                            type="button"
                            class="password-toggle
                                   absolute right-4 top-1/2
                                   -translate-y-1/2
                                   text-[#8B7765]"
                            data-target="newPassword"
                        >

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>


                    <p
                        class="text-xs text-[#8B7765]
                               mt-2"
                    >

                        Use at least 6 characters.

                    </p>

                </div>



                <!-- CONFIRM PASSWORD -->

                <div>

                    <label
                        for="confirmPassword"
                        class="block mb-2 font-medium"
                    >

                        Confirm New Password

                    </label>


                    <div class="relative">

                        <input
                            id="confirmPassword"
                            type="password"
                            name="confirmPassword"
                            required
                            minlength="6"
                            autocomplete="new-password"
                            placeholder="Confirm your new password"
                            class="w-full border border-[#E8DCCB]
                                   rounded-xl px-4 py-3 pr-12
                                   outline-none
                                   focus:border-[#C9A36B]"
                        >


                        <button
                            type="button"
                            class="password-toggle
                                   absolute right-4 top-1/2
                                   -translate-y-1/2
                                   text-[#8B7765]"
                            data-target="confirmPassword"
                        >

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                </div>



                <!-- PASSWORD REQUIREMENTS -->

                <div
                    class="rounded-2xl
                           border border-[#E8DCCB]
                           bg-[#F8F4EE] p-5"
                >

                    <p class="font-semibold">
                        Password requirements
                    </p>


                    <div
                        class="mt-3 space-y-2
                               text-sm text-[#6B5B50]"
                    >

                        <p>

                            <i
                                class="fa-solid fa-check
                                       text-[#C9A36B] mr-2"
                            ></i>

                            At least 6 characters

                        </p>


                        <p>

                            <i
                                class="fa-solid fa-check
                                       text-[#C9A36B] mr-2"
                            ></i>

                            Must be different from your
                            current password

                        </p>


                        <p>

                            <i
                                class="fa-solid fa-check
                                       text-[#C9A36B] mr-2"
                            ></i>

                            New password must match
                            confirmation

                        </p>

                    </div>

                </div>



                <!-- ACTIONS -->

                <div
                    class="flex flex-col-reverse
                           sm:flex-row gap-3 pt-2"
                >

                    <a
                        href="/admin/account"
                        class="flex-1 flex items-center
                               justify-center gap-2
                               border border-[#E8DCCB]
                               rounded-xl py-3
                               hover:bg-[#F8F4EE]
                               transition"
                    >

                        <i class="fa-solid fa-arrow-left"></i>

                        Cancel

                    </a>


                    <button
                        type="submit"
                        class="flex-1 flex items-center
                               justify-center gap-2
                               bg-[#C9A36B]
                               hover:bg-[#B89056]
                               text-[#2F241D]
                               font-semibold
                               rounded-xl py-3
                               transition"
                    >

                        <i class="fa-solid fa-key"></i>

                        Change Password

                    </button>

                </div>

            </form>



            <!-- SECURITY NOTICE -->

            <div
                class="mt-8 pt-6
                       border-t border-[#E8DCCB]"
            >

                <div class="flex items-start gap-3">

                    <i
                        class="fa-solid fa-shield-halved
                               text-[#C9A36B] mt-1"
                    ></i>

                    <p
                        class="text-xs text-[#8B7765]
                               leading-relaxed"
                    >

                        After changing your password,
                        you may be required to log in again
                        on other sessions.

                    </p>

                </div>

            </div>


        </div>

    </section>

</main>



<!-- PASSWORD TOGGLE + MOBILE SIDEBAR -->

<%- include('./updateToast')%>
<script src="/socket.io/socket.io.js"></script>
<script>

    const socket = io()

    socket.on('notify admin', notification => {
        showUpdate(notification.message)
    })

    const sidebar =
        document.querySelector('#sidebar')

    const mobileMenuButton =
        document.querySelector('#mobile-menu-button')

    const sidebarOverlay =
        document.querySelector('#sidebar-overlay')


    mobileMenuButton?.addEventListener('click', () => {

        sidebar.classList.toggle(
            '-translate-x-full'
        )

        sidebarOverlay.classList.toggle(
            'hidden'
        )

    })


    sidebarOverlay?.addEventListener('click', () => {

        sidebar.classList.add(
            '-translate-x-full'
        )

        sidebarOverlay.classList.add(
            'hidden'
        )

    })



    // PASSWORD VISIBILITY

    document
        .querySelectorAll('.password-toggle')
        .forEach(button => {

            button.addEventListener('click', () => {

                const input =
                    document.getElementById(
                        button.dataset.target
                    )

                const icon =
                    button.querySelector('i')


                if(input.type === 'password') {

                    input.type = 'text'

                    icon.classList.remove(
                        'fa-eye'
                    )

                    icon.classList.add(
                        'fa-eye-slash'
                    )

                } else {

                    input.type = 'password'

                    icon.classList.remove(
                        'fa-eye-slash'
                    )

                    icon.classList.add(
                        'fa-eye'
                    )

                }

            })

        })

</script>


</body>

</html>