<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Customers | FLOURish Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>


<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen">


    <!-- MOBILE HEADER -->

    <header
        class="lg:hidden bg-white border-b border-[#E8DCCB]
               h-16 px-5 flex items-center justify-between"
    >

        <a
            href="/admin/dashboard"
            class="flex items-center gap-2"
        >

            <i class="fa-solid fa-wheat-awn text-2xl text-[#C9A36B]"></i>

            <h1 class="font-serif text-2xl">
                FLOUR<span class="italic text-[#C9A36B]">ish</span>
            </h1>

        </a>


        <button
            id="mobile-menu-button"
            class="w-10 h-10 rounded-xl hover:bg-[#F8F4EE]"
        >

            <i class="fa-solid fa-bars"></i>

        </button>

    </header>



    <!-- SIDEBAR -->

    <aside
        id="sidebar"
        class="fixed left-0 top-0 bottom-0 w-64
               bg-white border-r border-[#E8DCCB]
               z-50 -translate-x-full lg:translate-x-0
               transition-transform duration-300"
    >

        <!-- LOGO -->

        <div
            class="h-20 px-6 flex items-center
                   border-b border-[#E8DCCB]"
        >

            <a
                href="/admin/dashboard"
                class="flex items-center gap-3"
            >

                <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                <h1 class="font-serif text-3xl">
                    FLOUR<span class="italic text-[#C9A36B]">ish</span>
                </h1>

            </a>

        </div>



        <!-- NAVIGATION -->

        <nav class="p-4 space-y-2">

            <p
                class="text-xs uppercase tracking-widest
                       text-[#A18D7B] px-3 mb-3"
            >
                Management
            </p>


            <a
                href="/admin/dashboard"
                class="flex items-center gap-3 px-4 py-3
                       rounded-xl hover:bg-[#F8F4EE] transition"
            >

                <i class="fa-solid fa-chart-line w-5 text-[#8B7765]"></i>

                Dashboard

            </a>


            <a
                href="/admin/orders"
                class="flex items-center gap-3 px-4 py-3
                       rounded-xl hover:bg-[#F8F4EE] transition"
            >

                <i class="fa-solid fa-bag-shopping w-5 text-[#8B7765]"></i>

                Orders

            </a>


            <a
                href="/admin/products"
                class="flex items-center gap-3 px-4 py-3
                       rounded-xl hover:bg-[#F8F4EE] transition"
            >

                <i class="fa-solid fa-box w-5 text-[#8B7765]"></i>

                Products

            </a>


            <a
                href="/admin/customers"
                class="flex items-center gap-3 px-4 py-3
                       rounded-xl bg-[#F8EFD8] font-semibold"
            >

                <i class="fa-solid fa-users w-5 text-[#C9A36B]"></i>

                Customers

            </a>

            <div class="pt-5">

                <p class="text-xs uppercase tracking-widest
                           text-[#A18D7B] px-3 mb-3">

                    Account

                </p>

                <a href="/admin/account" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold">

                    <i class="fa-solid fa-user-shield w-5 text-[#C9A36B]"></i>
                    Profile
                </a>
                
            </div>

            <!-- WEBSITE -->

            <div class="pt-5">

                <p
                    class="text-xs uppercase tracking-widest
                           text-[#A18D7B] px-3 mb-3"
                >
                    Website
                </p>


                <a
                    href="/"
                    class="flex items-center gap-3 px-4 py-3
                           rounded-xl hover:bg-[#F8F4EE] transition"
                >

                    <i
                        class="fa-solid fa-arrow-up-right-from-square
                               w-5 text-[#8B7765]"
                    ></i>

                    View Website

                </a>

            </div>

        </nav>



        <!-- ADMIN -->

        <div
            class="absolute bottom-0 left-0 right-0
                   p-4 border-t border-[#E8DCCB]"
        >

            <div class="flex items-center gap-3 px-3 py-3">

                <div
                    class="w-10 h-10 rounded-full bg-[#F8EFD8]
                           flex items-center justify-center"
                >

                    <i
                        class="fa-solid fa-user-shield
                               text-[#C9A36B]"
                    ></i>

                </div>


                <div>

                    <p class="font-semibold text-sm">
                        <%= admin.username%>
                    </p>

                    <p class="text-xs text-[#8B7765]">
                        Administrator
                    </p>

                </div>

            </div>


            <form
                action="/admin/logout"
                method="POST"
            >

                <button
                    type="submit"
                    class="w-full flex items-center gap-3
                           px-4 py-3 rounded-xl
                           text-red-600 hover:bg-red-50 transition"
                >

                    <i
                        class="fa-solid fa-right-from-bracket w-5"
                    ></i>

                    Logout

                </button>

            </form>

        </div>

    </aside>



    <!-- MOBILE OVERLAY -->

    <div
        id="sidebar-overlay"
        class="fixed inset-0 bg-black/30
               z-40 hidden lg:hidden"
    ></div>



    <!-- MAIN -->

    <main class="lg:ml-64 min-h-screen">


        <!-- DESKTOP HEADER -->

        <header
            class="hidden lg:flex h-20 bg-white
                   border-b border-[#E8DCCB]
                   px-8 items-center justify-between"
        >

            <div>

                <p class="text-sm text-[#8B7765]">
                    Administration
                </p>

                <h2 class="font-serif text-2xl">
                    Customers
                </h2>

            </div>


            <div class="flex items-center gap-3">

                <div
                    class="w-10 h-10 rounded-full bg-[#F8EFD8]
                           flex items-center justify-center"
                >

                    <i
                        class="fa-solid fa-user-shield
                               text-[#C9A36B]"
                    ></i>

                </div>


                <div>

                    <p class="font-semibold text-sm">
                        <%= admin.username%>
                    </p>

                    <p class="text-xs text-[#8B7765]">
                        Administrator
                    </p>

                </div>

            </div>

        </header>



        <!-- CONTENT -->

        <section class="p-5 sm:p-8 max-w-7xl mx-auto">


            <!-- TITLE -->

            <div class="mb-8">

                <p class="text-[#8B7765]">
                    Manage registered customers
                </p>

                <h1 class="font-serif text-4xl sm:text-5xl mt-1">
                    Customers
                </h1>

            </div>



            <!-- STAT CARDS -->

            <div
                class="grid sm:grid-cols-2 lg:grid-cols-3
                       gap-5 mb-8"
            >

                <div
                    class="bg-white border border-[#E8DCCB]
                           rounded-2xl p-6 shadow-sm"
                >

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-[#8B7765]">
                                Total Customers
                            </p>

                            <p
                                id="total-customers"
                                class="font-serif text-3xl mt-1"
                            >
                                <%= customers?.length || 0 %>
                            </p>

                        </div>


                        <div
                            class="w-12 h-12 rounded-xl
                                   bg-[#F8EFD8]
                                   flex items-center justify-center"
                        >

                            <i
                                class="fa-solid fa-users
                                       text-xl text-[#C9A36B]"
                            ></i>

                        </div>

                    </div>

                </div>



                <div
                    class="bg-white border border-[#E8DCCB]
                           rounded-2xl p-6 shadow-sm"
                >

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-[#8B7765]">
                                Customers With Orders
                            </p>

                            <p
                                id="customers-with-orders"
                                class="font-serif text-3xl mt-1"
                            >
                                <%= customers?.filter(c => c.orders?.length).length || 0 %>
                            </p>

                        </div>


                        <div
                            class="w-12 h-12 rounded-xl
                                   bg-green-50
                                   flex items-center justify-center"
                        >

                            <i
                                class="fa-solid fa-bag-shopping
                                       text-xl text-green-600"
                            ></i>

                        </div>

                    </div>

                </div>



                <div
                    class="bg-white border border-[#E8DCCB]
                           rounded-2xl p-6 shadow-sm"
                >

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-[#8B7765]">
                                New Customers
                            </p>

                            <p
                                class="font-serif text-3xl mt-1"
                            >

                                <%= customers?.filter(c => {

                                    if (!c.createdAt) return false

                                    const date = new Date(c.createdAt)
                                    const now = new Date()

                                    return (
                                        date.getMonth() === now.getMonth() &&
                                        date.getFullYear() === now.getFullYear()
                                    )

                                }).length || 0 %>

                            </p>

                        </div>


                        <div
                            class="w-12 h-12 rounded-xl
                                   bg-blue-50
                                   flex items-center justify-center"
                        >

                            <i
                                class="fa-solid fa-user-plus
                                       text-xl text-blue-600"
                            ></i>

                        </div>

                    </div>

                </div>

            </div>



            <!-- SEARCH -->

            <div
                class="bg-white border border-[#E8DCCB]
                       rounded-2xl p-5 shadow-sm mb-6"
            >

                <div class="relative">

                    <i
                        class="fa-solid fa-magnifying-glass
                               absolute left-4 top-1/2
                               -translate-y-1/2
                               text-[#A18D7B]"
                    ></i>


                    <input
                        id="customer-search"
                        type="text"
                        placeholder="Search by username or email..."
                        class="w-full border border-[#E8DCCB]
                               rounded-xl pl-11 pr-4 py-3
                               outline-none
                               focus:border-[#C9A36B]"
                    >

                </div>

            </div>



            <!-- CUSTOMERS -->

            <div
                class="bg-white border border-[#E8DCCB]
                       rounded-2xl shadow-sm overflow-hidden"
            >

                <!-- DESKTOP TABLE -->

                <div class="hidden md:block overflow-x-auto">

                    <table class="w-full">

                        <thead class="bg-[#F8F4EE]">

                            <tr
                                class="text-left text-sm
                                       text-[#8B7765]"
                            >

                                <th class="px-6 py-4 font-semibold">
                                    Customer
                                </th>

                                <th class="px-6 py-4 font-semibold">
                                    Email
                                </th>

                                <th class="px-6 py-4 font-semibold">
                                    Orders
                                </th>

                                <th class="px-6 py-4 font-semibold">
                                    Joined
                                </th>

                                <th class="px-6 py-4 font-semibold text-right">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="customers-table">

                            <% if (customers?.length) { %>

                                <% customers.forEach(customer => { %>

                                    <tr
                                        class="customer-row
                                               border-t border-[#E8DCCB]
                                               hover:bg-[#FCFAF7]
                                               transition"
                                        data-name="<%= customer.username %>"
                                        data-email="<%= customer.email %>"
                                    >

                                        <!-- CUSTOMER -->

                                        <td class="px-6 py-5">

                                            <div class="flex items-center gap-3">

                                                <div
                                                    class="w-11 h-11
                                                           rounded-full
                                                           bg-[#F8EFD8]
                                                           flex items-center
                                                           justify-center"
                                                >

                                                    <i
                                                        class="fa-solid fa-user
                                                               text-[#C9A36B]"
                                                    ></i>

                                                </div>


                                                <div>

                                                    <p class="font-semibold">
                                                        <%= customer.username %>
                                                    </p>

                                                    <p class="text-xs text-[#8B7765]">
                                                        Customer
                                                    </p>

                                                </div>

                                            </div>

                                        </td>



                                        <!-- EMAIL -->

                                        <td
                                            class="px-6 py-5
                                                   text-[#6B5B50]"
                                        >

                                            <%= customer.email %>

                                        </td>



                                        <!-- ORDERS -->

                                        <td class="px-6 py-5">

                                            <span
                                                class="inline-flex
                                                       items-center
                                                       px-3 py-1
                                                       rounded-full
                                                       bg-[#F8EFD8]
                                                       text-[#6B5B50]
                                                       text-sm
                                                       font-semibold"
                                            >

                                                <%= customer.orders?.length || 0 %>

                                            </span>

                                        </td>



                                        <!-- JOINED -->

                                        <td
                                            class="px-6 py-5
                                                   text-sm text-[#6B5B50]"
                                        >

                                            <%= customer.createdAt
                                                ? new Date(customer.createdAt).toLocaleDateString('en-IN')
                                                : '—'
                                            %>

                                        </td>



                                        <!-- ACTION -->

                                        <td class="px-6 py-5 text-right">

                                            <a
                                                href="/admin/customers/<%= customer._id %>"
                                                class="inline-flex
                                                       items-center gap-2
                                                       border
                                                       border-[#E8DCCB]
                                                       px-4 py-2
                                                       rounded-xl
                                                       hover:bg-[#F8F4EE]
                                                       transition"
                                            >

                                                <i class="fa-solid fa-eye"></i>

                                                View

                                            </a>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>



                <!-- MOBILE CARDS -->

                <div
                    id="customer-cards"
                    class="md:hidden divide-y
                           divide-[#E8DCCB]"
                >

                    <% if (customers?.length) { %>

                        <% customers.forEach(customer => { %>

                            <div
                                class="customer-card p-5"
                                data-name="<%= customer.username %>"
                                data-email="<%= customer.email %>"
                            >

                                <div class="flex items-center gap-4">

                                    <div
                                        class="w-12 h-12
                                               rounded-full
                                               bg-[#F8EFD8]
                                               flex items-center
                                               justify-center
                                               shrink-0"
                                    >

                                        <i
                                            class="fa-solid fa-user
                                                   text-[#C9A36B]"
                                        ></i>

                                    </div>


                                    <div class="flex-1 min-w-0">

                                        <p class="font-semibold truncate">
                                            <%= customer.username %>
                                        </p>

                                        <p
                                            class="text-sm text-[#8B7765]
                                                   truncate"
                                        >
                                            <%= customer.email %>
                                        </p>

                                    </div>


                                    <a
                                        href="/admin/customers/<%= customer._id %>"
                                        class="w-10 h-10 rounded-xl
                                               border border-[#E8DCCB]
                                               flex items-center
                                               justify-center
                                               hover:bg-[#F8F4EE]"
                                    >

                                        <i class="fa-solid fa-chevron-right"></i>

                                    </a>

                                </div>


                                <div
                                    class="flex items-center
                                           gap-6 mt-4 text-sm"
                                >

                                    <div>

                                        <p class="text-xs text-[#8B7765]">
                                            Orders
                                        </p>

                                        <p class="font-semibold">
                                            <%= customer.orders?.length || 0 %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-[#8B7765]">
                                            Joined
                                        </p>

                                        <p class="font-semibold">

                                            <%= customer.createdAt
                                                ? new Date(customer.createdAt).toLocaleDateString('en-IN')
                                                : '—'
                                            %>

                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    <% } %>

                </div>



                <!-- EMPTY STATE -->

                <div
                    id="empty-customers"
                    class="<%= customers?.length ? 'hidden' : '' %>
                           py-20 text-center"
                >

                    <div
                        class="w-16 h-16 mx-auto rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center"
                    >

                        <i
                            class="fa-solid fa-users
                                   text-2xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <h2 class="font-serif text-3xl mt-6">
                        No Customers
                    </h2>


                    <p class="text-[#8B7765] mt-2">
                        No customers have registered yet.
                    </p>

                </div>



                <!-- NO SEARCH RESULTS -->

                <div
                    id="no-results"
                    class="hidden py-16 text-center"
                >

                    <div
                        class="w-14 h-14 mx-auto rounded-full
                               bg-[#F8EFD8]
                               flex items-center justify-center"
                    >

                        <i
                            class="fa-solid fa-magnifying-glass
                                   text-xl text-[#C9A36B]"
                        ></i>

                    </div>


                    <h2 class="font-serif text-2xl mt-5">
                        No Matching Customers
                    </h2>


                    <p class="text-sm text-[#8B7765] mt-2">
                        Try searching with a different name or email.
                    </p>

                </div>

            </div>

        </section>

    </main>



    <!-- SCRIPT -->

    <script>

        const searchInput =
            document.querySelector('#customer-search')

        const rows =
            [...document.querySelectorAll('.customer-row')]

        const cards =
            [...document.querySelectorAll('.customer-card')]

        const noResults =
            document.querySelector('#no-results')


        function filterCustomers() {

            const search =
                searchInput?.value.trim().toLowerCase() || ''


            let visible = 0


            rows.forEach(row => {

                const name =
                    (row.dataset.name || '').toLowerCase()

                const email =
                    (row.dataset.email || '').toLowerCase()


                const matches =
                    !search ||
                    name.includes(search) ||
                    email.includes(search)


                row.classList.toggle(
                    'hidden',
                    !matches
                )


                if (matches) visible++

            })


            cards.forEach(card => {

                const name =
                    (card.dataset.name || '').toLowerCase()

                const email =
                    (card.dataset.email || '').toLowerCase()


                const matches =
                    !search ||
                    name.includes(search) ||
                    email.includes(search)


                card.classList.toggle(
                    'hidden',
                    !matches
                )

            })


            noResults?.classList.toggle(
                'hidden',
                visible !== 0
            )

        }


        searchInput?.addEventListener(
            'input',
            filterCustomers
        )



        // MOBILE SIDEBAR

        const sidebar =
            document.querySelector('#sidebar')

        const mobileMenuButton =
            document.querySelector('#mobile-menu-button')

        const sidebarOverlay =
            document.querySelector('#sidebar-overlay')


        mobileMenuButton?.addEventListener(
            'click',
            () => {

                sidebar.classList.toggle(
                    '-translate-x-full'
                )

                sidebarOverlay.classList.toggle(
                    'hidden'
                )

            }
        )


        sidebarOverlay?.addEventListener(
            'click',
            () => {

                sidebar.classList.add(
                    '-translate-x-full'
                )

                sidebarOverlay.classList.add(
                    'hidden'
                )

            }
        )

    </script>


</body>

</html>