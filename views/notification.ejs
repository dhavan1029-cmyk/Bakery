<div
    id="notificationToast"
    class="fixed top-5 right-5 z-[100] w-[360px] max-w-[calc(100vw-2rem)]
           bg-white border border-[#E8DCCB] rounded-2xl shadow-xl
           p-4 flex items-start gap-4
           translate-x-[120%] opacity-1
           transition-all duration-300 ease-out"
>
    
    <!-- ICON -->

    <div
        class="w-11 h-11 shrink-0 rounded-xl
               bg-[#F8EFD8] flex items-center justify-center"
    >
        <i class="fa-solid fa-bell text-[#C9A36B] text-lg"></i>
    </div>


    <!-- CONTENT -->

    <div class="flex-1 min-w-0">

        <div class="flex items-center justify-between gap-3">

            <p class="font-semibold text-[#4A3428]">
                Notification
            </p>

            <button
                id="closeNotification"
                class="text-[#A18D7B] hover:text-[#4A3428]
                       transition"
                aria-label="Close notification"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <p
            id="notificationMessage"
            class="text-sm text-[#8B7765] mt-1 leading-relaxed"
        >
            Your order status has been updated.
        </p>

    </div>

</div>
<script>
    const notificationToast =
        document.querySelector('#notificationToast')
    
    const notificationMessage =
        document.querySelector('#notificationMessage')
    
    const closeNotification =
        document.querySelector('#closeNotification')
    
    
    let notificationTimeout
    
    
    function showNotification(message) {
    
        notificationMessage.textContent = message
    
        clearTimeout(notificationTimeout)
    
        notificationToast.classList.remove(
            'translate-x-[120%]',
            'opacity-0'
        )
    
        notificationToast.classList.add(
            'translate-x-0',
            'opacity-100'
        )
    
        notificationTimeout = setTimeout(() => {
            hideNotification()
        }, 5000)
    }
    
    
    function hideNotification() {
    
        notificationToast.classList.remove(
            'translate-x-0',
            'opacity-100'
        )
    
        notificationToast.classList.add(
            'translate-x-[120%]',
            'opacity-0'
        )
    }
    
    
    closeNotification.addEventListener(
        'click',
        hideNotification
    )
</script>