<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cart | FLOURish</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body class="bg-[#F8F4EE] text-[#4A3428] min-h-screen flex flex-col">




    <!-- NAVBAR -->

    <nav class="sticky top-0 z-50 bg-[#F8F4EE]/80 backdrop-blur-md border-b border-[#E8DCCB]">

        <div class="max-w-7xl mx-auto">

            <div class="h-20 flex items-center justify-between">

                <a href="/" class="flex items-center gap-3">

                    <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                    <h1 class="font-serif text-4xl">

                        FLOUR<span class="italic text-[#C9A36B]">ish</span>

                    </h1>

                </a>

                <a href="/menu"
                   class="font-medium hover:text-[#C9A36B] transition">

                    Continue Shopping

                </a>

            </div>

        </div>

    </nav>
    <% if(err) { %>
        <div class="mt-[15vh] max-w-3xl mx-auto bg-white border border-[#E8DCCB] rounded-3xl p-10 text-center shadow-sm">

            <div class="w-20 h-20 mx-auto rounded-full bg-[#F8EFD8] flex items-center justify-center">

                <i class="fa-solid fa-cart-shopping text-4xl text-[#C9A36B]"></i>

            </div>

            <h2 class="mt-8 font-serif text-4xl">
                We Couldn't Load Your Cart
            </h2>

            <p class="mt-4 text-[#6B5B50] leading-relaxed max-w-lg mx-auto">
                Something went wrong while retrieving your cart items.
                Please try again in a few moments.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">

                <button
                    onclick="location.reload()"
                    class="px-8 py-3 bg-[#C9A36B] text-[#2F241D] font-semibold rounded-xl hover:bg-[#B89056] transition"
                >
                    <i class="fa-solid fa-rotate-right mr-2"></i>
                    Try Again
                </button>

                <a
                    href="/menu"
                    class="px-8 py-3 border border-[#E8DCCB] rounded-xl font-semibold hover:bg-[#F8F4EE] transition"
                >
                    Continue Shopping
                </a>

            </div>

        </div>
    <% } else { %>

        <!-- HEADER -->

        <section class="py-8">

            <div class="max-w-7xl mx-auto px-6 lg:px-10">

                <h1 class="font-serif text-6xl">

                    Shopping Cart

                </h1>

                <p class="mt-3 text-[#6B5B50]">

                    Review your selected products before checkout.

                </p>

            </div>

        </section>



        <% let isEmpty = false %>
        <% if(!user || cartItems.length === 0){ %>

            <% isEmpty = true %>

        <% } %>

        <% const emptyCartClass = 'flex-1 ' + (!isEmpty ? 'hidden' : '')%>
        <% const cartClass = 'pb-24 flex-1 ' + (isEmpty ? 'hidden' : '') %>
        
        <section id="emptyCart" class='<%= emptyCartClass%>'>

            <div class="max-w-4xl mx-auto px-6 py-20 text-center">

                <i class="fa-solid fa-cart-shopping text-8xl text-[#C9A36B]"></i>

                <h2 class="font-serif text-4xl mt-8">

                    Your Cart Is Empty

                </h2>

                <p class="mt-4 text-[#6B5B50]">

                    Fresh breads, cakes and pastries are waiting for you.

                </p>

                <a href="/menu"

                   class="inline-block mt-8 bg-[#C9A36B] px-8 py-4 rounded-xl font-semibold hover:bg-[#B89056] transition">

                   Browse Menu
                </a>

            </div>

        </section>

        <% if(!isEmpty){ %>
        <!-- CART -->

            <section id="cart" class="<%=cartClass%>">
                <div class="max-w-7xl mx-auto px-6 lg:px-10">
                    <%
                    const hasUnavailableProducts = cartItems.some(item => !item.product.availability);
                    %>

                    
                    
                    <div id="cartWarning"
                    class="mb-8 rounded-3xl border border-red-200 bg-[#FFF7F5] px-6 py-5 <%= !hasUnavailableProducts ? ' hidden' : ''%>">
                    
                        <div class="flex gap-4">
                        
                            <i class="fa-solid fa-circle-exclamation text-2xl text-red-500 mt-1"></i>
                        
                            <div>
                            
                                <h3 class="font-semibold text-xl">
                                
                                    Some items in your cart are unavailable
                                
                                </h3>
                            
                                <p class="mt-2 text-[#6B5B50]">
                                
                                    Remove unavailable items before proceeding to checkout.
                                
                                </p>
                            
                            </div>
                        
                        </div>
                    
                    </div>

                    <div class="grid lg:grid-cols-3 gap-10">


                        <%
                        let quantityExceeded = false
                        %>

                        <!-- ITEMS -->

                        <div class="lg:col-span-2 space-y-6">

                        <% cartItems.forEach(item => { %>

                            <%
                                const priceChange = prices?.find(
                                    price => price[0].toString() === item.product._id.toString()
                                );
                            %>
                                                
                            <div
                                class="<%= !item.product.availability || priceChange
                                    ? 'unavailable'
                                    : 'available'
                                %> items bg-white rounded-3xl p-6 shadow-sm
                                <%= !item.product.availability
                                    ? 'border-2 border-red-200 opacity-80'
                                    : priceChange
                                        ? 'border-2 border-amber-200'
                                        : ''
                                %>"
                            >
                                                
                                <div class="flex flex-col md:flex-row gap-6">
                                
                                    <!-- IMAGE -->
                                
                                    <div
                                        class="w-full md:w-36 h-36 rounded-2xl bg-[#E8DCCB] flex items-center justify-center shrink-0 relative overflow-hidden"
                                        style="<%= item.product.image
                                            ? `background-image:url('${item.product.image}');background-size:cover;background-position:center;`
                                            : ''
                                        %>"
                                    >
                                
                                        <% if (!item.product.image) { %>
                                        
                                            <% if (item.product.category === 'Breads') { %>
                                            
                                                <i class="fa-solid fa-bread-slice text-5xl text-[#C9A36B]"></i>
                                            
                                            <% } else if (item.product.category === 'Cookies') { %>
                                            
                                                <i class="fa-solid fa-cookie-bite text-5xl text-[#C9A36B]"></i>
                                            
                                            <% } else if (item.product.category === 'Cakes') { %>
                                            
                                                <i class="fa-solid fa-cake-candles text-5xl text-[#C9A36B]"></i>
                                            
                                            <% } else { %>
                                            
                                                <i class="fa-solid fa-wheat-awn text-5xl text-[#C9A36B]"></i>
                                            
                                            <% } %>
                                            
                                        <% } %>
                                            
                                    </div>
                                
                                
                                    <!-- INFO -->
                                
                                    <div class="flex-1">
                                    
                                        <p class="uppercase tracking-wide text-xs text-[#C9A36B]">
                                            <%= item.product.category %>
                                        </p>
                                    
                                        <h2 class="font-serif text-3xl mt-2">
                                        
                                            <%
                                                let name = item.product.name;
                                                let isQuantityExceeded = item.quantity > item.product.maxQuantityPerOrder ? true : false

                                                if(isQuantityExceeded) quantityExceeded = true
                                                if (item.product.quantity > 1) {
                                                    name += ` (Pack of ${item.product.quantity})`;
                                                }
                                            %>
                                            
                                            <%= name %>
                                            
                                        </h2>
                                    
                                    
                                        <!-- AVAILABILITY -->
                                    
                                        <% if (item.product.availability) { %>
                                        
                                            <div class="mt-3 inline-flex items-center gap-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">
                                            
                                                <i class="fa-solid fa-circle-check"></i>
                                            
                                                In Stock
                                            
                                            </div>
                                        
                                        <% } else { %>
                                        
                                            <div class="mt-3 inline-flex items-center gap-2 bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-medium">
                                            
                                                <i class="fa-solid fa-circle-exclamation"></i>
                                            
                                                Out of Stock
                                            
                                            </div>
                                        
                                        <% } %>
                                        
                                        
                                        <!-- PRICE -->
                                        
                                        <p class="font-bold text-xl mt-4">
                                            ₹<%= item.product.price %>
                                        </p>
                                    
                                    
                                        <!-- PRICE CHANGE WARNING -->
                                    
                                        <% if (priceChange) { %>
                                        
                                            <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4">
                                            
                                                <div class="flex gap-3">
                                                
                                                    <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-1"></i>
                                                
                                                    <div>
                                                    
                                                        <p class="font-semibold text-[#4A3428]">
                                                            Price updated
                                                        </p>
                                                    
                                                        <p class="text-sm text-[#6B5B50] mt-1">
                                                            The price of this product changed from
                                                            <strong>₹<%= priceChange[1] %></strong>
                                                            to
                                                            <strong>₹<%= item.product.price %></strong>.
                                                        </p>
                                                    
                                                        <p class="text-sm text-[#6B5B50] mt-1">
                                                            Your cart has been updated to the current price.
                                                        </p>
                                                    
                                                    </div>
                                                
                                                </div>
                                            
                                            </div>
                                        
                                        <% } %>

                                        <div class="quantity-exceeded-warning <%= !isQuantityExceeded ? 'hidden' : ''%> mt-5 rounded-2xl border border-red-200 bg-[#FFF7F5] px-5 py-4">
                                            
                                            <div class="flex gap-3">
                                            
                                                <i class="fa-solid fa-triangle-exclamation text-red-500 mt-1"></i>
                                            
                                                <div>
                                                
                                                    <p class="font-semibold text-[#4A3428]">
                                                    
                                                        Quantity exceeds the maximum allowed.
                                                    
                                                    </p>
                                                
                                                    <p class="text-sm text-[#6B5B50] mt-1">
                                                    
                                                        You can order a maximum of
                                                        <strong><%= item.product.maxQuantityPerOrder %></strong>
                                                        of this product in a single order.
                                                        Reduce the quantity before proceeding to checkout.
                                                    
                                                    </p>
                                                
                                                </div>
                                            
                                            </div>
                                        
                                        </div>
                                        
                                        
                                        <!-- QUANTITY -->
                                        
                                        <div class="mt-5 flex items-center gap-3">
                                        
                                            <button
                                                class="decrease-btn w-10 h-10 rounded-full border border-[#E8DCCB] disabled:opacity-40 disabled:cursor-not-allowed"
                                                data-id="<%= item.product._id %>"
                                                max="<%= item.product.maxQuantityPerOrder %>"
                                                <%= !item.product.availability ? 'disabled' : '' %>
                                            >
                                                -
                                            </button>
                                        
                                            <span class="quantity font-medium">
                                                <%= item.quantity %>
                                            </span>
                                        
                                            <button
                                                class="increase-btn w-10 h-10 rounded-full border border-[#E8DCCB] disabled:opacity-40 disabled:cursor-not-allowed"
                                                data-id="<%= item.product._id %>"
                                                max="<%= item.product.maxQuantityPerOrder %>"
                                                <%= !item.product.availability ? 'disabled' : '' %>
                                            >
                                                +
                                            </button>
                                        
                                        </div>
                                    
                                    
                                        <!-- OUT OF STOCK -->
                                    
                                        <% if (!item.product.availability) { %>
                                        
                                            <div class="mt-5 rounded-2xl border border-red-200 bg-[#FFF7F5] px-5 py-4">
                                            
                                                <div class="flex gap-3">
                                                
                                                    <i class="fa-solid fa-triangle-exclamation text-red-500 mt-1"></i>
                                                
                                                    <div>
                                                    
                                                        <p class="font-semibold text-[#4A3428]">
                                                            This product is currently unavailable.
                                                        </p>
                                                    
                                                        <p class="text-sm text-[#6B5B50] mt-1">
                                                            Remove this item from your cart before proceeding to checkout.
                                                        </p>
                                                    
                                                    </div>
                                                
                                                </div>
                                            
                                            </div>
                                        
                                        <% } %>
                                        
                                    </div>
                                
                                
                                    <!-- RIGHT -->
                                
                                    <div class="flex md:flex-col justify-between items-end">
                                    
                                        <p class="line-total font-bold text-xl">
                                            ₹<%= item.product.price * item.quantity %>
                                        </p>
                                    
                                        <button
                                            class="remove-btn text-red-500 hover:text-red-700 transition"
                                            data-id="<%= item.product._id %>"
                                        >
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    
                                    </div>
                                
                                </div>
                            
                            </div>
                        
                        <% }) %>
                                                
                        </div>
                                            
                                            


                        <!-- SUMMARY -->

                        <div>

                            <div class="bg-white rounded-3xl p-8 shadow-sm sticky top-28">

                                <h2 class="font-serif text-4xl">

                                    Order Summary

                                </h2>

                                <div class="mt-8 space-y-5">

                                    <div class="flex justify-between">

                                        <span>Subtotal</span>

                                        <span id="subtotal">₹<%= subtotal %></span>

                                    </div>

                                    <div class="flex justify-between">

                                        <span>Delivery</span>

                                        <span>₹<%= deliveryFee %></span>

                                    </div>

                                    <div class="border-t border-[#E8DCCB] pt-5 flex justify-between font-bold text-xl">

                                        <span>Total</span>

                                        <span id="total">₹<%= total %></span>

                                    </div>

                                </div>

                                <button
                                    id="checkoutBtn"
                                    onclick="window.location.href = '/checkout'"
                                    class="block text-center w-full mt-8 bg-[#C9A36B] py-4 rounded-xl font-semibold hover:bg-[#B89056] transition"
                                    <%= hasUnavailableProducts || quantityExceeded ? 'disabled' : '' %>
                                >

                                    Proceed To Checkout

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            <section>

        <% } %>


    <% } %>        
    <!-- FOOTER -->

    <footer class="bg-gradient-to-b from-[#3A2E25] to-[#241B15] text-[#F8F4EE] mt-[10vh]">

        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-10 text-center">

            <p class="text-[#6B5B50]">

                © 2026 FLOURish Bakery. All rights reserved.

            </p>

        </div>

    </footer>

    <%- include('./loadAnimation')%>

    <script src="/scripts/load.js"></script>

    <script src="/scripts/cart.js" type="module"></script>
</body>
</html>