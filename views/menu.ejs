<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Our Menu | FLOURish</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body class="bg-[#F8F4EE] text-[#4A3428]">




    <!-- NAVBAR -->

    <nav class="sticky top-0 left-0 w-full z-50 bg-[#F8F4EE]/80 backdrop-blur-md border-b border-[#E8DCCB]">

        <div class="w-[90%] mx-auto ">

            <div class="h-20 flex items-center justify-between">

                <a href="/" class="flex items-center gap-3">

                    <i class="fa-solid fa-wheat-awn text-3xl text-[#C9A36B]"></i>

                    <h1 class="font-serif text-4xl">

                        FLOUR<span class="italic text-[#C9A36B]">ish</span>

                    </h1>

                </a>

                <div class="flex items-center gap-6">

                    <a href="/cart">
                        <i class="fa-solid fa-cart-shopping text-lg hover:text-[#C9A36B] transition"></i>
                    </a>

                    <%if (user) {%>
                        <a href="/account">
                            <i class="fa-regular fa-user text-lg hover:text-[#C9A36B] transition"></i>
                            <!-- <%=user%> -->
                        </a>
                    <% } else {%>
                        <a href="/login">
                            <i class="fa-regular fa-user text-lg hover:text-[#C9A36B] transition"></i>
                            <!-- <%=user%> -->
                        </a>
                    <% } %>

                </div>

            </div>

        </div>

    </nav>




    <!-- HERO -->

    <section class="py-20">

        <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">

            <h1 class="font-serif text-6xl md:text-7xl">

                Our Menu

            </h1>

            <p class="mt-5 text-[#6B5B50] text-lg">

                Freshly baked breads, pastries, cakes and sweet treats.

            </p>

        </div>

    </section>




    <!-- SEARCH -->

    <section class="pb-8">

        <div class="relative max-w-3xl mx-auto px-6">

            <form id="productSearchBar">

                <div class="relative">

                    <i class="fa-solid fa-magnifying-glass absolute left-5 top-1/2 -translate-y-1/2 text-[#8B7765]"></i>

                    <input
                        type="text"
                        name="q"
                        placeholder="Search products..."
                        class="w-full bg-white rounded-full border border-[#E8DCCB] py-4 pl-14 pr-5 outline-none focus:border-[#C9A36B]"
                    >

                </div>

            </form>

            <div id="searchResults" class="hidden absolute max-h-[16.5rem] left-6 right-6 mt-2 bg-white border border-[#E8DCCB] rounded-2xl shadow-lg overflow-auto z-50">

                <div id="loadingAnimation" class="hidden">

                    <div class="bg-white rounded-2xl border border-[#E8DCCB] shadow-lg overflow-hidden">

                        <!-- Skeleton Result -->

                        <div class="animate-pulse flex items-center gap-4 p-4 border-b border-[#F3ECE3]">

                            <div class="w-14 h-14 rounded-lg bg-[#E8DCCB]"></div>

                            <div class="flex-1">

                                <div class="h-4 w-40 bg-[#E8DCCB] rounded"></div>

                                <div class="h-3 w-20 bg-[#E8DCCB] rounded mt-3"></div>

                            </div>

                        </div>

                        <!-- Skeleton Result -->

                        <div class="animate-pulse flex items-center gap-4 p-4 border-b border-[#F3ECE3]">
                        
                            <div class="w-14 h-14 rounded-lg bg-[#E8DCCB]"></div>
                        
                            <div class="flex-1">
                            
                                <div class="h-4 w-32 bg-[#E8DCCB] rounded"></div>
                            
                                <div class="h-3 w-24 bg-[#E8DCCB] rounded mt-3"></div>
                            
                            </div>
                        
                        </div>
                    
                        <!-- Skeleton Result -->
                    
                        <div class="animate-pulse flex items-center gap-4 p-4">
                        
                            <div class="w-14 h-14 rounded-lg bg-[#E8DCCB]"></div>
                        
                            <div class="flex-1">
                            
                                <div class="h-4 w-48 bg-[#E8DCCB] rounded"></div>
                            
                                <div class="h-3 w-16 bg-[#E8DCCB] rounded mt-3"></div>
                            
                            </div>
                        
                        </div>

                    </div>

                </div>

                <div id="noSearchResults" class="hidden py-12 px-6 text-center">

                    <div class="w-20 h-20 mx-auto rounded-full bg-[#F5EBDD] flex items-center justify-center">

                        <i class="fa-solid fa-magnifying-glass text-3xl text-[#C9A36B]"></i>

                    </div>

                    <h3 class="mt-6 font-serif text-2xl">

                        No Products Found

                    </h3>

                </div>
            
            </div>
        
        </div>

    </section>




    <!-- FILTERS -->

    <section class="pb-8">

        <div class="max-w-7xl mx-auto px-6 lg:px-10">

            <div class="flex flex-wrap justify-center gap-4">

                <button class="bg-[#C9A36B] px-6 py-3 rounded-full font-semibold" id="all">
                    All
                </button>

                <button class="bg-white border border-[#E8DCCB] px-6 py-3 rounded-full" id="breads">
                    Breads
                </button>

                <button class="bg-white border border-[#E8DCCB] px-6 py-3 rounded-full" id="pastries">
                    Pastries
                </button>

                <button class="bg-white border border-[#E8DCCB] px-6 py-3 rounded-full" id="cakes">
                    Cakes
                </button>

                <button class="bg-white border border-[#E8DCCB] px-6 py-3 rounded-full" id="cookies">
                    Cookies
                </button>

            </div>

        </div>

    </section>


    <div class="lg:w-[40vw] mb-5 m-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 px-6 lg:px-10">

        <!-- FILTER -->

        <div class="relative">

            <button
                id="filter-btn"
                class="flex items-center justify-between gap-3 w-full sm:w-56 px-5 py-3 bg-white border border-[#E8DCCB] rounded-2xl hover:border-[#C9A36B] transition"
            >

                <div class="flex items-center gap-3">

                    <i class="fa-solid fa-filter text-[#C9A36B]"></i>

                    <span class="font-medium">

                        Filter By

                    </span>

                </div>

                <i class="fa-solid fa-chevron-down text-xs"></i>

            </button>

            <div
                id="filter-menu"
                class="hidden absolute mt-3 w-full bg-white border border-[#E8DCCB] rounded-2xl shadow-lg p-5"
            >

                <p class="text-xs uppercase tracking-widest text-[#8B7765] mb-4">
                    Availability
                </p>
            
                <label class="flex items-center gap-3 cursor-pointer">
                    <input
                        type="checkbox"
                        id="filter-available"
                        class="w-4 h-4 accent-[#C9A36B]"
                        <%= available === 'true' ? 'checked' : '' %>
                        onchange="updateQuery('available', this.checked ? true : 'all')"
                    >
                
                    <span>
                        In Stock
                    </span>
                </label>
            
                <label class="flex items-center gap-3 mt-3 cursor-pointer">
                    <input
                        type="checkbox"
                        id="filter-unavailable"
                        class="w-4 h-4 accent-[#C9A36B]"
                        <%= available === 'false' ? 'checked' : '' %>
                        onchange="updateQuery('available', this.checked ? false : 'all')"
                    >
                
                    <span>
                        Out of Stock
                    </span>
                </label>
            
                <div class="border-t border-[#E8DCCB] my-5"></div>
            
                <p class="text-xs uppercase tracking-widest text-[#8B7765] mb-4">
                    Price
                </p>
            
                <label class="flex items-center gap-3 cursor-pointer" onclick="updateQuery('priceRange', [0, Infinity])">
                    <input
                        type="radio"
                        name="price-filter"
                        value="all"
                        <%= price?.[0] == 0 && price?.[1] == Infinity ? 'checked' : '' %>
                        class="w-4 h-4 accent-[#C9A36B]"
                    >
                
                    <span>
                        All Prices
                    </span>
                </label>
            
                <label class="flex items-center gap-3 mt-3 cursor-pointer" onclick="updateQuery('priceRange', [0, 500])">
                    <input
                        type="radio"
                        name="price-filter"
                        value="under500"
                        class="w-4 h-4 accent-[#C9A36B]"
                        <%= price?.[0] == 0 && price?.[1] == 500 ? 'checked' : '' %>
                    >
                
                    <span>
                        Under ₹500
                    </span>
                </label>
            
                <label class="flex items-center gap-3 mt-3 cursor-pointer" onclick="updateQuery('priceRange', [500, 1000])">
                    <input
                        type="radio"
                        name="price-filter"
                        value="500-1000"
                        class="w-4 h-4 accent-[#C9A36B]"
                        <%= price?.[0] == 500 && price?.[1] == 1000 ? 'checked' : '' %>
                    >
                
                    <span>
                        ₹500 – ₹1,000
                    </span>
                </label>
            
                <label class="flex items-center gap-3 mt-3 cursor-pointer" onclick="updateQuery('priceRange', [1000, Infinity])">
                    <input
                        type="radio"
                        name="price-filter"
                        value="over1000"
                        class="w-4 h-4 accent-[#C9A36B]"
                        <%= price?.[0] == 1000 && price?.[1] == Infinity ? 'checked' : '' %>                    >
                
                    <span>
                        Above ₹1,000
                    </span>
                </label>
            
            </div>

        </div>



        <!-- SORT -->

        <div class="relative">

            <button
                id="sort-btn"
                class="flex items-center justify-between gap-3 w-full sm:w-56 px-5 py-3 bg-white border border-[#E8DCCB] rounded-2xl hover:border-[#C9A36B] transition"
            >

                <div class="flex items-center gap-3">

                    <i class="fa-solid fa-arrow-up-wide-short text-[#C9A36B]"></i>

                    <span class="font-medium">

                        Sort By

                    </span>

                </div>

                <i class="fa-solid fa-chevron-down text-xs"></i>

            </button>

            <div
                id="sort-menu"
                class="hidden absolute mt-3 w-full bg-white border border-[#E8DCCB] rounded-2xl shadow-lg overflow-hidden"
            >
            
                <button
                    type="button"
                    data-sort="price-low"
                    class="sort-option w-full text-left px-5 py-4 hover:bg-[#FAF7F2] transition flex items-center gap-3"
                    onclick="updateQuery('sort', 'price-low')"
                >
            
                    <i class="fa-solid fa-arrow-down-wide-short text-[#C9A36B] w-5"></i>
            
                    <span>
                        Price: Low to High
                    </span>
                
                </button>
            
                <button
                    type="button"
                    data-sort="price-high"
                    class="sort-option w-full text-left px-5 py-4 hover:bg-[#FAF7F2] transition flex items-center gap-3"
                    onclick="updateQuery('sort', 'price-high')"
                >
            
                    <i class="fa-solid fa-arrow-up-wide-short text-[#C9A36B] w-5"></i>
            
                    <span>
                        Price: High to Low
                    </span>
                
                </button>
            
                <button
                    type="button"
                    data-sort="name-az"
                    class="sort-option w-full text-left px-5 py-4 hover:bg-[#FAF7F2] transition flex items-center gap-3"
                    onclick="updateQuery('sort', 'A-Z')"
                >
            
                    <i class="fa-solid fa-arrow-down-a-z text-[#C9A36B] w-5"></i>
            
                    <span>
                        Name: A–Z
                    </span>
                
                </button>
            
                <button
                    type="button"
                    data-sort="name-za"
                    class="sort-option w-full text-left px-5 py-4 hover:bg-[#FAF7F2] transition flex items-center gap-3"
                    onclick="updateQuery('sort', 'Z-A')"
                >
            
                    <i class="fa-solid fa-arrow-down-z-a text-[#C9A36B] w-5"></i>
            
                    <span>
                        Name: Z–A
                    </span>
                
                </button>
            
                <button
                    type="button"
                    data-sort="newest"
                    class="sort-option w-full text-left px-5 py-4 hover:bg-[#FAF7F2] transition flex items-center gap-3"
                    onclick="updateQuery('sort', 'new')"
                >
            
                    <i class="fa-solid fa-clock text-[#C9A36B] w-5"></i>
            
                    <span>
                        Newest
                    </span>
                
                </button>
            
            </div>

        </div>

    </div>


    <!-- PRODUCTS -->

    <section class="pb-24">

        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="hidden text-center py-20" id="noProducts">
            
                <i class="fa-solid fa-bread-slice text-7xl text-[#C9A36B]"></i>

                <h2 id='statusMessage' class="mt-6 text-3xl font-serif text-center">
                    No Products Found
                </h2>

                <button 
                class="mt-10 inline-flex items-center justify-center gap-2 bg-[#C9A36B] hover:bg-[#B89056 font-serif text-xl px-8 py-3 rounded-xl transition-colors duration-200 focus:outline-none focus:ring-4 focus:ring-[#C9A36B]/30 active:scale-95"
                onclick="location.reload()"
                >Retry</button>
            </div>

            

            <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8" id="products">

                <% products.forEach(product => { %>

                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition" category=<%=product.category%>>

                        <!-- PRODUCT IMAGE -->

                        <div
                            class="h-64 flex items-center justify-center bg-[#E8DCCB]"
                            style="<%= product.image ? `background-image:url('${product.image}'); background-size:cover; background-position:center;` : '' %>"
                         >

                            <% if(!product.image){ %>

                                <% if(product.category === 'Breads'){ %>

                                    <i class="fa-solid fa-bread-slice text-7xl text-[#C9A36B]"></i>

                                <% } else if(product.category === 'Pastries'){ %>

                                    <i class="fa-solid fa-croissant text-7xl text-[#C9A36B]"></i>

                                <% } else if(product.category === 'Cakes'){ %>

                                    <i class="fa-solid fa-cake-candles text-7xl text-[#C9A36B]"></i>

                                <% } else { %>

                                    <i class="fa-solid fa-cookie-bite text-7xl text-[#C9A36B]"></i>

                                <% } %>

                            <% } %>

                        </div>

                        <!-- CONTENT -->

                        <div class="p-5">

                            <p class="uppercase tracking-wide text-xs text-[#C9A36B]">

                                <%= product.category %>

                            </p>

                            <h3 class="font-serif text-2xl mt-2 line-clamp-1">

                                <%= product.name %>

                            </h3>

                            <p class="mt-3 text-[#6B5B50] line-clamp-2">

                                <%= product.description %>

                            </p>

                            <div class="mt-5 flex items-center justify-between">

                                <span class="font-bold text-xl">

                                    ₹<%= product.price %>

                                </span>

                                <a
                                    href="/product/<%= product._id %>"
                                    class="bg-[#C9A36B] px-4 py-2 rounded-md font-medium hover:bg-[#B89056] transition"
                                >

                                    View

                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </section>




    <!-- FOOTER -->

    <footer class="bg-gradient-to-b from-[#3A2E25] to-[#241B15] text-[#F8F4EE]">

        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12">

            <div class="flex flex-col md:flex-row justify-between items-center gap-6">

                <h3 class="font-serif text-3xl">

                    FLOUR<span class="italic text-[#C9A36B]">ish</span>

                </h3>

                <div class="flex gap-5 text-xl">

                    <i class="fa-brands fa-instagram"></i>

                    <i class="fa-brands fa-facebook"></i>

                    <i class="fa-brands fa-pinterest"></i>

                    <i class="fa-brands fa-x-twitter"></i>

                </div>

            </div>

            <div class="text-center mt-10 text-[#6B5B50]">

                © 2026 FLOURish Bakery. All rights reserved.

            </div>

        </div>

    </footer>

    <%- include('./notification') %>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const products = JSON.parse('<%- JSON.stringify(products) %>');
        const err = '<%=err %>'
    </script>
    <script src="/scripts/menu.js"></script>
</body>
</html>